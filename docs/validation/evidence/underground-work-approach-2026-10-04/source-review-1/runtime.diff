+func test_headless_entry_work_wait_and_recovery_resume_the_original_source_clock() -> void:
+	"""Refused ticks cannot erase or bank any ENTRY, loop-seam wait, recovery or partial-entry retrace phase."""
+	_clock_profiles()
+	var job: Vector2i = _clock_job()
+	var first: Vector2i = _location(Vector3i(-512, 0, 512))
+	assert_equal(_routes.admit_work_actor(_worker, job, first, 24, 1, 2, 0, -1), &"", "actual source WORK admission")
+	var state: PackedInt64Array = PackedInt64Array([0, 0, 0, 0])
+	for tick: int in range(1, 7): assert_equal(_routes.advance_tick(tick), 1, "six source entry ticks")
+	_binding.refusal = &"SYNTHETIC_SOURCE_STOP"
+	assert_equal(_routes.advance_tick(7), 0, "entry observation refuses")
+	assert_equal(_routes.source_state_into(_worker, job, 24, 1, 2, state), &"", "held entry tuple stays current")
+	assert_equal(state, PackedInt64Array([Routes.SourceProgram.ENTRY, 6 * 65536, 0, Routes.PHASE_HELD]), "entry clock survives refusal")
+	_binding.refusal = &""
+	for tick: int in range(8, 32): assert_equal(_routes.advance_tick(tick), 1, "remaining24 accepted entry ticks")
+	assert_equal(Routes.source_work_leaf_refusal(_routes, _worker, job, 24, 1, 2), &"", "exact30 accepted ticks enter WORK")
+	for tick: int in range(32, 35): assert_equal(_routes.advance_tick(tick), 1, "three productive source ticks")
+	assert_equal(_routes.request_source_ready(_worker, job), &"", "actual stop retains original loop seam")
+	_binding.refusal = &"SYNTHETIC_SOURCE_STOP"
+	assert_equal(_routes.advance_tick(35), 0, "seam wait observation refuses")
+	assert_equal(_routes.source_state_into(_worker, job, 24, 1, 2, state), &"", "held seam tuple stays current")
+	assert_equal(state, PackedInt64Array([Routes.SourceProgram.RECOVERY_WAIT, 3 * 65536, 0, Routes.PHASE_HELD]), "seam phase is not erased")
+	_binding.refusal = &""
+	for tick: int in range(36, 69): assert_equal(_routes.advance_tick(tick), 1, "remaining33 source loop ticks")
+	assert_equal(_routes.source_state_into(_worker, job, 24, 1, 2, state), &"", "exact seam state")
+	assert_equal(state, PackedInt64Array([Routes.SourceProgram.RECOVERY, 0, 0, Routes.PHASE_IDLE]), "recovery begins only at complete loop seam")
+	for tick: int in range(69, 79): assert_equal(_routes.advance_tick(tick), 1, "ten accepted recovery ticks")
+	_binding.refusal = &"SYNTHETIC_SOURCE_STOP"
+	assert_equal(_routes.advance_tick(79), 0, "recovery observation refuses")
+	assert_equal(_routes.source_state_into(_worker, job, 24, 1, 2, state), &"", "held recovery tuple stays current")
+	assert_equal(state, PackedInt64Array([Routes.SourceProgram.RECOVERY, 10 * 65536, 0, Routes.PHASE_HELD]), "recovery time does not accumulate")
+	_binding.refusal = &""
+	for tick: int in range(80, 100): assert_equal(_routes.advance_tick(tick), 1, "remaining20 accepted recovery ticks")
+	assert_equal(Routes.source_ready_leaf_refusal(_routes, _worker, job, 24, 1, 2), &"", "exact30 accepted ticks return to ready")
+	assert_equal(_routes.refresh_work_actor(_worker, job, 24, 1, 2, 0, -1), &"", "fresh entry requires actual ready handoff")
+	for tick: int in range(100, 106): assert_equal(_routes.advance_tick(tick), 1, "partial actual entry")
+	assert_equal(_routes.request_source_ready(_worker, job), &"", "partial entry requests retrace")
+	for tick: int in range(106, 112): assert_equal(_routes.advance_tick(tick), 1, "exact partial source retrace")
+	assert_equal(Routes.source_ready_leaf_refusal(_routes, _worker, job, 24, 1, 2), &"", "retrace closes at the original shared ready")
