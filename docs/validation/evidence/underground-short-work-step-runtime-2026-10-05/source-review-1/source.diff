+func _canonical_short_edges() -> PackedInt32Array:
+	"""Publish real source masks for the finite forward/back step and a different ordinary ground span."""
+	var first: Vector3i = Vector3i(X + 512, 512, Z + 512)
+	var last: Vector3i = first + Vector3i(232, 0, 0)
+	var short_end: Vector2i = _location(last)
+	var token: int = _begin()
+	var result: PackedInt32Array = PackedInt32Array([short_end.x, short_end.y])
+	for direction: int in 3:
+		var edge: Routes.Edge = _edge()
+		if direction < 2:
+			edge.from_location = _first if direction == 0 else short_end
+			edge.to_location = short_end if direction == 0 else _first
+			var a: Vector3i = first if direction == 0 else last
+			var b: Vector3i = last if direction == 0 else first
+			edge.points = PackedInt32Array([a.x, a.y, a.z, b.x, b.y, b.z])
+			edge.length_u = 232
+		var added: Routes.Result = _routes.stage_add(token, edge)
+		assert_equal(added.error, &"", "complete source proof before mask publication")
+		result.append_array(PackedInt32Array([added.ref.x, added.ref.y]))
+	assert_equal(_binding.seal(token), &"", "same actual candidate")
+	assert_equal(_binding.publish(token), &"", "real graph/masks atomic publication")
+	_end(token)
+	return result
