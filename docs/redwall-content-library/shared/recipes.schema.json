{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Redwall research recipes",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "redwall_research_recipes_v1"
    },
    "activation": {
      "const": "NOT_RUNTIME_ACTIVE"
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "book_key": {
            "enum": [
              "redwall",
              "mossflower",
              "salamandastron",
              "martin_warrior",
              "outcast",
              "pearls_lutra",
              "long_patrol",
              "marlfox",
              "lord_brocktree",
              "taggerung",
              "triss",
              "rakkety_tam"
            ]
          },
          "local_id": {
            "type": "string",
            "minLength": 1
          },
          "source_food_id": {
            "type": "string",
            "minLength": 1
          },
          "source_label": {
            "type": "string",
            "minLength": 1
          },
          "game_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "production_candidate": {
            "type": "boolean"
          },
          "source_occurrence": {
            "type": "string",
            "minLength": 1
          },
          "source_locators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "block_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "block_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "source_start": {
                  "type": "object",
                  "properties": {
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unit_block": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "unit",
                    "unit_block"
                  ],
                  "additionalProperties": false
                },
                "source_end": {
                  "type": "object",
                  "properties": {
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unit_block": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "unit",
                    "unit_block"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "block_start",
                "block_end",
                "source_start",
                "source_end"
              ],
              "additionalProperties": false
            }
          },
          "source_ingredients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ingredient": {
                  "type": "string",
                  "minLength": 1
                },
                "raw_evidence": {
                  "type": "object"
                }
              },
              "required": [
                "ingredient",
                "raw_evidence"
              ],
              "additionalProperties": false
            }
          },
          "inferred_game_ingredients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ingredient": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "confidence": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_type": {
                  "const": "INFERRED_GAME"
                }
              },
              "required": [
                "ingredient",
                "reason",
                "confidence",
                "evidence_type"
              ],
              "additionalProperties": false
            }
          },
          "game_ingredients": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "game_method_steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "method_evidence": {
            "type": "string",
            "minLength": 1
          },
          "source_preparation_context": {
            "type": "string"
          },
          "adaptation_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "raw_recipe_path": {
            "type": "string",
            "minLength": 1
          },
          "quantities_status": {
            "const": "NOT_BALANCED_LIBRARY_CANDIDATE"
          },
          "runtime_activation": {
            "const": "NOT_RUNTIME_ACTIVE"
          }
        },
        "required": [
          "id",
          "book_key",
          "local_id",
          "source_food_id",
          "source_label",
          "game_label",
          "production_candidate",
          "source_occurrence",
          "source_locators",
          "source_ingredients",
          "inferred_game_ingredients",
          "game_ingredients",
          "game_method_steps",
          "method_evidence",
          "source_preparation_context",
          "adaptation_notes",
          "raw_recipe_path",
          "quantities_status",
          "runtime_activation"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "production_candidate": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "game_label": {
                  "type": "string",
                  "minLength": 1
                },
                "game_ingredients": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "game_method_steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "else": {
              "properties": {
                "game_label": {
                  "type": "null"
                },
                "game_method_steps": {
                  "type": "array",
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "activation",
    "recipes"
  ],
  "additionalProperties": false
}
