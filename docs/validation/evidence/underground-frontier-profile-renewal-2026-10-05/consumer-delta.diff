+class ProspectiveCheck extends Check:
+	## One borrowed cold context; all normal source/target/body/stance checks remain inherited unchanged.
+	var context: Locations.FrontierContext = null
+
+	func endpoint_current_refusal() -> StringName:
+		"""Candidate visibility requires original ownership, and never makes this contact publicly live."""
+		var code: StringName = Locations.frontier_scope_refusal(actual.locations, context)
+		if code == &"" and endpoint.payload_revision > 0 and not endpoint_matches(): return REFUSE_STALE
+		return code
+
+	func read_endpoint_into(out: Locations.Record) -> StringName:
+		"""Read only one declared full candidate handle into the same bounded caller scratch."""
+		return Locations.frontier_location_into(actual.locations, context, request.location, out)
+
+	func facts_refusal() -> StringName:
+		"""The new exact-context source leaf leaves the old live-only FinalFacts door strict."""
+		return FinalFacts.frontier_refusal(actual.owner, actual.routes, actual.locations, context, proof.remaining)
+
+	func endpoint_matches() -> bool:
+		"""Direct packed comparisons follow every ordinary source/geometry observer."""
+		return Locations.frontier_record_matches(actual.locations, context, request.location, endpoint)
+
