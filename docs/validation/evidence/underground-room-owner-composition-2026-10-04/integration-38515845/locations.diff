+static func _frontier_heap_pop(before: PackedInt32Array, patch: PackedInt32Array, count: int,
+		clear_tail: bool) -> bool:
+	"""Both actual allocators use the same minimum-heap sift; only the graph canonically erases its popped tail."""
+	count -= 1
+	var tail: int = _frontier_heap_at(before, patch, count)
+	var index: int = 0
+	while index * 2 + 1 < count:
+		var child: int = index * 2 + 1
+		if child + 1 < count and _frontier_heap_at(before, patch, child + 1) < _frontier_heap_at(before, patch, child): child += 1
+		var value: int = _frontier_heap_at(before, patch, child)
+		if value >= tail: break
+		if not _frontier_heap_set(patch, index, value): return false
+		index = child
+	if (count > 0 or not clear_tail) and not _frontier_heap_set(patch, index, tail): return false
+	return _frontier_heap_set(patch, count, -1) if clear_tail else true
+
+
+static func _frontier_heap_at(before: PackedInt32Array, patch: PackedInt32Array, index: int) -> int:
+	"""The caller precharges the complete84-pair lookup before final validation; absent entries borrow original storage."""
+	for pair: int in (FRONTIER_HEAP_WORDS >> 1):
+		if patch[pair * 2] == index: return patch[pair * 2 + 1]
+		if patch[pair * 2] == -1: break
+	return before[index]
+
+
+static func _frontier_heap_set(patch: PackedInt32Array, index: int, value: int) -> bool:
+	"""Update a previous sparse write or one preallocated empty pair, refusing any unaccounted growth."""
+	for pair: int in (FRONTIER_HEAP_WORDS >> 1):
+		if patch[pair * 2] == -1 or patch[pair * 2] == index:
+			patch[pair * 2] = index; patch[pair * 2 + 1] = value
+			return true
+	return false
+
+
+static func _frontier_order_refusal(actual: RefCounted) -> StringName:
+	"""Canonical sorted index and complete free prefix retain actual allocation semantics after an observer."""
+	var bank: Bank = actual._stage
+	if bank.ordered.size() != actual._capacity or bank.free_rows.size() != actual._capacity \
+			or bank.count < 0 or bank.count > actual._capacity or bank.free_count < 0 \
+			or bank.free_count > actual._capacity: return &"LOCATION_FRONTIER_ROWS"
+	var count: int = 0
+	for row: int in actual._capacity:
+		if bank.present[row] == 1:
+			if bank.ordered[count] != row: return &"LOCATION_FRONTIER_ROWS"
+			count += 1
+	if count != bank.count: return &"LOCATION_FRONTIER_ROWS"
+	for index: int in actual._capacity:
+		if index >= count and bank.ordered[index] != -1: return &"LOCATION_FRONTIER_ROWS"
+	for index: int in bank.free_count:
+		var row: int = bank.free_rows[index]
+		if row < 0 or row >= actual._capacity or bank.present[row] != 0 or bank.retired[row] != 0:
+			return &"LOCATION_FRONTIER_ROWS"
+	return &""
+
+
+static func _frontier_unchanged_rows(actual: RefCounted, context: FrontierContext) -> StringName:
+	"""All old and unused row payloads remain byte-identical, apart from exactly the bounded new allocations."""
+	for row: int in actual._capacity:
+		var is_new: bool = false
+		for index: int in context.count: is_new = is_new or context.refs[2 * index] == row
+		if is_new:
+			if actual._live.present[row] != 0 or actual._stage.present[row] != 1 \
+					or actual._get32(actual._stage, GENERATION, row) != actual._get32(actual._live, GENERATION, row) + 1:
+				return &"LOCATION_FRONTIER_ROWS"
+		else:
+			if actual._live.present[row] != actual._stage.present[row]: return &"LOCATION_FRONTIER_ROWS"
+			for field: int in I32_FIELDS:
+				if actual._get32(actual._live, field, row) != actual._get32(actual._stage, field, row): return &"LOCATION_FRONTIER_ROWS"
+			for field: int in I64_FIELDS:
+				if actual._get64(actual._live, field, row) != actual._get64(actual._stage, field, row): return &"LOCATION_FRONTIER_ROWS"
+		if actual._live.retired[row] != actual._stage.retired[row]: return &"LOCATION_FRONTIER_ROWS"
+	return &""
+
