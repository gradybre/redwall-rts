+	probe.actual = SettlementSystem.ground_piles()
+	probe.ui = _ui
+	assert_true(SettlementSystem.buildings().set_placement_authority(probe).ok, "observed actual authority")
+	var ok: bool = _ui.create_world()
+	SettlementSystem.buildings().set_placement_authority(SettlementSystem.ground_piles())
+	probe.ui = null
+	assert_true(probe.invoked, "real observer called")
+	assert_false(probe.nested_ok, "nested action refused")
+	assert_true(probe.report_unchanged, "outer published report retained")
+	assert_true(ok, "outer actual creation succeeds")
+	assert_equal(SettlementSystem.population(), 12, "one complete cohort")
+	assert_true(SettlementSystem.world().is_published(), "actual World remains live")
+	assert_equal(_ui.world_session().generated_count(), 1, "no nested generation")
+	assert_true(SettlementSystem.reset(), "cleanup")
+
+
+func test_late_cleanup_refusal_keeps_actual_world_and_original_failure_code() -> void:
+	"""The post-colony/remount cleanup helper checks a real busy reset rather than claiming empty."""
+	var session: UndergroundSessionScript = _mount_created_world()
+	var token: int = session._budget.acquire(64)
+	var before: PackedByteArray = SettlementSystem.directory().state_bytes()
+	var report: UiWorldSessionScript.Report = _ui.world_session().last_report()
+	assert_false(_ui._cleanup_failed_create(report, &"TEST_REMOUNT_STAGE", "remount failed"), "stage remains failed")
+	assert_equal(report.error, &"TEST_REMOUNT_STAGE", "original stage error preserved")
+	assert_equal(report.reset_error, &"UNDERGROUND_SESSION_NOT_QUIESCENT", "original cleanup error preserved")
+	assert_equal(report.reset_state, UiWorldSessionScript.RESET_RETAINED, "actual host retained World")
+	assert_equal(SettlementSystem.directory().state_bytes(), before, "no store clear")
+	assert_true(_ui.world_session().has_world(), "UI did not discard still-live map")
+	assert_equal(session._budget.release(token), &"", "only test lease released")
+	assert_false(_ui._cleanup_failed_create(report, &"TEST_REMOUNT_STAGE", "remount failed"), "retry cleanup, no success claim")
+	assert_equal(report.reset_state, UiWorldSessionScript.RESET_CLEARED, "actual clear verified")
+	assert_false(_ui.world_session().has_world(), "only now map withdrawn")
+	assert_equal(SettlementSystem.population(), 0, "actual clear emptied population")
+
+
+func test_actual_remount_refusal_checks_cleanup_before_withdrawing_map() -> void:
+	"""An unloaded image really refuses remount; successful cleanup then withdraws the map."""
+	assert_true(_ui.create_world(), "actual generated World")
+	var report: UiWorldSessionScript.Report = _ui.world_session().last_report()
+	var missing: UndergroundContentScript = UndergroundContentScript.new()
+	assert_false(_ui._restore_underground_after_create(true, report, missing), "actual source refusal")
+	assert_true(report.error != &"", "exact owner refusal retained")
+	assert_equal(report.reset_state, UiWorldSessionScript.RESET_CLEARED, "actual cleanup checked")
+	assert_equal(report.reset_error, &"", "cleanup itself succeeded")
+	assert_false(_ui.world_session().has_world(), "map no longer live")
+	assert_equal(SettlementSystem.population(), 0, "actual cleanup")
