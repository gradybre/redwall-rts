+func test_partial_actual_clear_preserves_scope_request_and_original_reset_error() -> void:
+	"""A real mounted host with a deliberately incomplete clear cannot be disguised as retained."""
+	var host: PartialClearHost = PartialClearHost.new()
+	_reset_host = host
+	assert_true(host.create_generated_settlement(host.item_definitions()), "actual old World")
+	var content: UndergroundContent = UndergroundContent.new()
