+			or owner._r_lo_y[section.x] != bank.i32[Y * capacity + row] \
+			or bank.i32[X * capacity + row] < owner._r_lo_x[section.x] or bank.i32[X * capacity + row] >= owner._r_hi_x[section.x] \
+			or bank.i32[Z * capacity + row] < owner._r_lo_z[section.x] or bank.i32[Z * capacity + row] >= owner._r_hi_z[section.x]:
+		return &"LOCATION_SECTION_STALE"
