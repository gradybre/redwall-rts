+static func _frontier_shapes(actual: RefCounted) -> bool:
+	"""Every direct final column read stays within the original preallocated typed banks, including malformed candidates."""
+	if actual == null or actual._live == null or actual._stage == null or actual._live == actual._stage \
+			or actual._edge_capacity < 1 or actual._edge_capacity > MAX_EDGES \
+			or actual._vertex_capacity < 1 or actual._vertex_capacity > MAX_VERTICES: return false
+	return _frontier_bank_shape(actual._live, actual._edge_capacity, actual._vertex_capacity) \
+		and _frontier_bank_shape(actual._stage, actual._edge_capacity, actual._vertex_capacity)
+
+
+static func _frontier_bank_shape(bank: EdgeBank, edges: int, vertices: int) -> bool:
+	"""Capacities and prefix counts are checked before paths, free heaps, generations or adjacency are indexed."""
+	return bank.fields.size() == EDGE_FIELDS * edges and bank.longs.size() == EDGE_LONGS * edges \
+		and bank.present.size() == edges and bank.retired.size() == edges and bank.free_rows.size() == edges \
+		and bank.ordered.size() == edges and bank.vertices.size() == 3 * vertices \
+		and bank.edge_count >= 0 and bank.edge_count <= edges and bank.free_count >= 0 and bank.free_count <= edges \
+		and bank.vertex_count >= 0 and bank.vertex_count <= vertices
+
+
+static func _frontier_order_refusal(actual: RefCounted) -> StringName:
+	"""A complete strictly ordered adjacency index cannot lose, repeat or redirect an actual present edge."""
+	var bank: EdgeBank = actual._stage
+	if bank.ordered.size() != actual._edge_capacity or bank.free_rows.size() != actual._edge_capacity \
+			or bank.edge_count < 0 or bank.edge_count > actual._edge_capacity: return &"ROUTE_FRONTIER_ROWS"
+	var count: int = 0
+	for row: int in actual._edge_capacity:
+		if bank.present[row] == 1: count += 1
+	if count != bank.edge_count: return &"ROUTE_FRONTIER_ROWS"
+	for index: int in actual._edge_capacity:
+		var row: int = bank.ordered[index]
+		if index >= count:
+			if row != -1: return &"ROUTE_FRONTIER_ROWS"
+		elif row < 0 or row >= actual._edge_capacity or bank.present[row] != 1 \
+				or (index > 0 and not actual._edge_less(bank, bank.ordered[index - 1], row)): return &"ROUTE_FRONTIER_ROWS"
+	return &""
+
+
+static func _frontier_new_rows(actual: RefCounted, context: Locations.FrontierContext) -> StringName:
+	"""Every previously absent slot is unchanged unless it is one of the bounded exact declared allocations."""
+	for row: int in actual._edge_capacity:
+		if actual._stage.retired[row] != actual._live.retired[row]: return &"ROUTE_FRONTIER_ROWS"
+		if actual._live.present[row] != 0: continue
+		var ordinal: int = -1
+		for index: int in 2 * context.count:
+			if context.edges[2 * index] == row:
+				if ordinal >= 0: return &"ROUTE_FRONTIER_ROWS"
+				ordinal = index
+		if ordinal >= 0:
+			if actual._stage.present[row] != 1 or context.edges[2 * ordinal + 1] \
+					!= actual._stage.fields[E_GENERATION * actual._edge_capacity + row] \
+					or actual._stage.fields[E_GENERATION * actual._edge_capacity + row] \
+					!= actual._live.fields[E_GENERATION * actual._edge_capacity + row] + 1 \
+					or actual._stage.fields[E_PATH_COUNT * actual._edge_capacity + row] != 2 \
+					or actual._stage.fields[E_PATH_START * actual._edge_capacity + row] \
+					!= actual._live.vertex_count + 2 * ordinal: return &"ROUTE_FRONTIER_ROWS"
+		else:
+			if actual._stage.present[row] != 0: return &"ROUTE_FRONTIER_ROWS"
+			for field: int in EDGE_FIELDS:
+				if actual._live.fields[field * actual._edge_capacity + row] \
+						!= actual._stage.fields[field * actual._edge_capacity + row]: return &"ROUTE_FRONTIER_ROWS"
+			for field: int in EDGE_LONGS:
+				if actual._live.longs[field * actual._edge_capacity + row] \
+						!= actual._stage.longs[field * actual._edge_capacity + row]: return &"ROUTE_FRONTIER_ROWS"
+	return &""
+
+
+func _frontier_publish_blocked() -> bool:
+	"""Generic graph publication cannot expose one half of a synchronous add-only contact transaction."""
+	if _locations == null or _locations._frontier == null: return false
+	_locations._remaining = -1
+	return true
