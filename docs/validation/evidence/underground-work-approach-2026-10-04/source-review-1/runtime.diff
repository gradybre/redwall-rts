+func test_source_clock_helper_timing_uses_real_owners_and_preserves_read_only_state() -> void:
+	"""Measure guarded source checks separately from physical world qualification; synthetic geometry is explicit."""
+	_clock_profiles()
+	var job: Vector2i = _clock_job()
+	var first: Vector2i = _location(Vector3i(-512, 0, 512))
+	assert_equal(_routes.admit_work_actor(_worker, job, first, 24, 1, 2, 0, -1), &"", "actual actor and assigned Job")
+	for tick: int in range(1, 31): assert_equal(_routes.advance_tick(tick), 1, "headless source entry")
+	var state: PackedInt64Array = PackedInt64Array([0, 0, 0, 0])
+	assert_equal(_routes.source_state_into(_worker, job, 24, 1, 2, state), &"", "original source state")
+	var passed: int = 0
+	var start: int = Time.get_ticks_usec()
+	for _sample: int in 4096:
+		passed += int(Routes.SourceProgram.profile_refusal(_profiles, 24, 1, 2) == &"")
+	var digest_us: int = Time.get_ticks_usec() - start
+	start = Time.get_ticks_usec()
+	for _sample: int in 4096:
+		passed += int(Routes.actor_phase_in(_routes, _worker) == Routes.PHASE_IDLE)
+	var phase_us: int = Time.get_ticks_usec() - start
+	start = Time.get_ticks_usec()
+	for _sample: int in 4096:
+		passed += int(Routes.source_work_leaf_refusal(_routes, _worker, job, 24, 1, 2) == &"")
+	var work_us: int = Time.get_ticks_usec() - start
+	assert_equal(passed, 3 * 4096, "all timed calls used valid exact current source facts")
+	assert_equal(_routes.source_state_into(_worker, job, 24, 1, 2, state), &"", "source remains current")
+	assert_equal(state, PackedInt64Array([Routes.SourceProgram.WORK, 0, 0, Routes.PHASE_IDLE]), "reads cannot advance the source clock")
+	start = Time.get_ticks_usec()
+	passed = 0
+	for tick: int in range(31, 543): passed += _routes.advance_tick(tick)
+	var tick_us: int = Time.get_ticks_usec() - start
+	assert_equal(passed, 512, "timed headless ticks keep all existing actual-owner guards")
+	print("SOURCE-CLOCK-TIMING samples4096 digest_us=", digest_us, " phase_us=", phase_us,
+		" work_us=", work_us, " one_actor_ticks512_us=", tick_us, " synthetic_geometry=true qualification=false")
+
 
