 	return _local_tiles_refusal(bounds, purpose)
 
 
+static func prepared_local_leaf_refusal(actual: RefCounted, bounds: PackedInt32Array, purpose: int,
+		expected_revision: int, owner_token: int, cold_token: int) -> StringName:
+	"""Final Room facts use only concrete stored columns; no owner observation runs after the last observer."""
+	if actual == null: return REFUSE_BINDING
+	actual._conflict_ref = NULL_REF
+	actual._conflict_tile = -1
+	if owner_token <= 0 or actual._budget == null or cold_token <= 0 \
+			or actual._budget._token != cold_token or actual._budget._used < Budget.COLD_BYTES:
+		return REFUSE_BINDING
+	var code: StringName = _final_binding_refusal(actual, expected_revision, owner_token)
+	if code != &"": return code
+	if purpose < DIG or purpose > EXCLUSIONS or not Space.valid_box(bounds) \
+			or not Space.contains_box(actual._domain_bounds, bounds): return REFUSE_BOUNDS
+	return _final_local_tiles(actual, bounds, purpose)
+
+
+static func _final_binding_refusal(actual: RefCounted, revision: int, token: int) -> StringName:
+	"""Original source wiring, published World generation and sealed candidate remain exact without virtual reads."""
+	var space: Owner = actual._space.get_ref() as Owner if actual._space != null else null
+	var reader: Owner.CoreSources = actual._sources.get_ref() as Owner.CoreSources if actual._sources != null else null
+	if not actual._ready or space == null or reader == null or revision < 1 \
+			or space._header[17] != revision or actual._checked_geometry_revision != revision \
+			or space._sources != reader or space._stage_token != token or not space._sealed \
+			or space._validation_sources >= 0 or space._s_header[17] != revision + 1 \
+			or space._domain == null or space._domain._world != actual._world_ref \
+			or space._domain._bounds != actual._domain_bounds or not _final_owners_match(actual, reader):
+		return REFUSE_BINDING
+	return &""
+
+
+static func _final_owners_match(actual: RefCounted, reader: Owner.CoreSources) -> bool:
+	"""Actual private mirrors close transitive World/Nodes/Buildings/Construction/Directory getters."""
+	var world: World = actual._world
+	var nodes: Nodes = actual._nodes
+	var buildings: Buildings = actual._buildings
+	var ids: Directory = reader._directory
+	return world != null and nodes != null and buildings != null and ids != null \
+		and world._published and world._published_seed == actual._seed and world._nodes == nodes \
+		and world._directory == ids and nodes._directory == ids and buildings._directory == ids \
+		and reader._buildings == buildings and reader._construction != null \
+		and reader._construction._directory == ids and reader._construction._buildings == buildings \
+		and buildings._definitions != null and world._terrain.size() == World.TILE_COUNT \
+		and nodes._resource_slot.size() == World.TILE_COUNT and buildings._building_slot.size() == World.TILE_COUNT \
+		and Owner.CoreSources._final_row(ids, actual._world_ref, Directory.KIND_WORLD) >= 0
+
+
+static func _final_local_tiles(actual: RefCounted, bounds: PackedInt32Array, purpose: int) -> StringName:
+	"""The same bounded tile census and fixed integer coordinates precede every direct column lookup."""
+	@warning_ignore("integer_division") var first_x: int = bounds[0] / World.TILE_SIZE_UNITS
+	@warning_ignore("integer_division") var last_x: int = (bounds[3] - 1) / World.TILE_SIZE_UNITS
+	@warning_ignore("integer_division") var first_z: int = bounds[2] / World.TILE_SIZE_UNITS
+	@warning_ignore("integer_division") var last_z: int = (bounds[5] - 1) / World.TILE_SIZE_UNITS
+	if first_x < 0 or first_z < 0 or last_x >= World.MAP_TILES_X or last_z >= World.MAP_TILES_Z:
+		return REFUSE_BOUNDS
+	if (last_x - first_x + 1) * (last_z - first_z + 1) > LOCAL_TILE_LIMIT: return &"TERRAIN_LOCAL_CAPACITY"
+	for z: int in range(first_z, last_z + 1):
+		for x: int in range(first_x, last_x + 1):
+			var code: StringName = _final_local_tile(actual, z * World.MAP_TILES_X + x, bounds, purpose)
+			if code != &"": return code
+	return &""
+
+
+static func _final_local_tile(actual: RefCounted, tile: int, bounds: PackedInt32Array, purpose: int) -> StringName:
+	"""Preserve natural dry/water/exterior rules without treating an observed copy as a final fact."""
+	var terrain: int = actual._world._terrain[tile]
+	if terrain < 0 or terrain >= World.TERRAIN_COUNT: return &"TERRAIN_WORLD_KIND"
+	var floor_y: int = _natural_floor(tile, terrain)
+	if (floor_y == BOTTOM_U and (purpose != EXCLUSIONS or bounds[1] < 0)) \
+			or (floor_y < 0 and bounds[1] < 0 and bounds[4] > floor_y):
+		return _final_conflict(actual, REFUSE_WATER, actual._world_ref, tile)
+	if (purpose == DIG or purpose == FOOTING) and bounds[4] > floor_y:
+		return _final_conflict(actual, REFUSE_DRY, actual._world_ref, tile)
+	if purpose == EXTERIOR and bounds[1] < maxi(floor_y, 0):
+		return _final_conflict(actual, REFUSE_EXTERIOR, actual._world_ref, tile)
+	if purpose == FOOTING: return &""
+	var code: StringName = _final_local_resource(actual, tile, bounds)
+	return _final_local_building(actual, tile, bounds, purpose) if code == &"" else code
+
+
+static func _final_local_resource(actual: RefCounted, tile: int, bounds: PackedInt32Array) -> StringName:
+	"""Full Directory identity, mirrored owner and exact tile map precede current stock/regrowth extents."""
+	var nodes: Nodes = actual._nodes
+	var row: int = nodes._resource_slot[tile]
+	if row == Nodes.NO_NODE: return &""
+	if row < 0 or row >= nodes._present.size() or nodes._present[row] != 1:
+		return _final_conflict(actual, Nodes.REFUSE_NOT_PRESENT, NULL_REF, tile)
+	var ref: Vector2i = Vector2i(nodes._ref_slot[row], nodes._ref_generation[row])
+	if Owner.CoreSources._final_row(nodes._directory, ref, Directory.KIND_RESOURCE_NODE) != row:
+		return _final_conflict(actual, Nodes.REFUSE_NOT_PRESENT, ref, tile)
+	if nodes._tile[row] != tile: return _final_conflict(actual, &"TERRAIN_RESOURCE_TILE", ref, tile)
+	var kind: int = actual._resource_ids.find(nodes._resource_id[row])
+	if kind < 0 or nodes._quantity_milli[row] < 0 or nodes._regrow_days[row] < 0:
+		return _final_conflict(actual, &"TERRAIN_RESOURCE_CATALOG", ref, tile)
+	if nodes._quantity_milli[row] == 0 and nodes._regrow_days[row] == 0: return &""
+	var low: int = World.LAND_Y_UNITS - (1024 if kind == 0 else 4096)
+	var high: int = World.LAND_Y_UNITS + ((8192 if nodes._quantity_milli[row] > 0 else 256) if kind == 0 else 1024)
+	return _final_conflict(actual, REFUSE_RESOURCE, ref, tile) if _vertical_overlap(bounds, low, high) else &""
+
+
+static func _final_local_building(actual: RefCounted, tile: int, bounds: PackedInt32Array, purpose: int) -> StringName:
+	"""Every current Building map row, including an unregistered new foundation, stays a real exclusion."""
+	var buildings: Buildings = actual._buildings
+	var row: int = buildings._building_slot[tile]
+	if row == Buildings.NO_LINK: return &""
+	if row < 0 or row >= buildings._b_present.size() or buildings._b_present[row] != 1:
+		return _final_conflict(actual, Buildings.REFUSE_STALE_BUILDING_REF, NULL_REF, tile)
+	var ref: Vector2i = Vector2i(buildings._b_ref_slot[row], buildings._b_ref_generation[row])
+	if Owner.CoreSources._final_row(buildings._directory, ref, Directory.KIND_BUILDING) != row:
+		return _final_conflict(actual, Buildings.REFUSE_STALE_BUILDING_REF, ref, tile)
+	var code: StringName = _final_building_footprint(actual, row, tile)
+	if code != &"": return _final_conflict(actual, code, ref, tile)
+	var type_id: int = buildings._b_type_id[row]
+	if _vertical_overlap(bounds, World.LAND_Y_UNITS - actual._depth[type_id], World.LAND_Y_UNITS):
+		return _final_conflict(actual, REFUSE_FOUNDATION, ref, tile)
+	if (purpose == EXTERIOR or purpose == EXCLUSIONS) \
+			and _vertical_overlap(bounds, World.LAND_Y_UNITS, World.LAND_Y_UNITS + actual._height[type_id]):
+		return _final_conflict(actual, REFUSE_BODY, ref, tile)
+	return &""
+
+
+static func _final_building_footprint(actual: RefCounted, row: int, tile: int) -> StringName:
+	"""Keep the ordinary type, origin, rotation, state and rotated footprint checks using immutable definitions."""
+	var buildings: Buildings = actual._buildings
+	var definitions: Definitions = buildings._definitions
+	var type_id: int = buildings._b_type_id[row]
+	var origin: int = buildings._b_origin_tile[row]
+	if type_id < 0 or type_id >= definitions._building_count or type_id >= actual._depth.size() \
+			or type_id >= actual._height.size() or origin < 0 or origin >= World.TILE_COUNT \
+			or buildings._b_rotation[row] < 0 or buildings._b_rotation[row] > 3 \
+			or buildings._b_state[row] < 0 or buildings._b_state[row] >= Buildings.STATE_COUNT:
+		return &"TERRAIN_BUILDING_CONTENT"
+	var width: int = definitions._b_footprint_x[type_id]
+	var depth: int = definitions._b_footprint_z[type_id]
+	if buildings._b_rotation[row] % 2 != 0:
+		var original: int = width
+		width = depth
+		depth = original
+	@warning_ignore("integer_division") var dz: int = tile / World.MAP_TILES_X - origin / World.MAP_TILES_X
+	var dx: int = tile % World.MAP_TILES_X - origin % World.MAP_TILES_X
+	return &"TERRAIN_BUILDING_FOOTPRINT" if dx < 0 or dz < 0 or dx >= width or dz >= depth else &""
+
+
+static func _final_conflict(actual: RefCounted, code: StringName, ref: Vector2i, tile: int) -> StringName:
+	"""Reuse existing diagnostic scalars without calling an overridable recorder."""
+	actual._conflict_ref = ref
+	actual._conflict_tile = tile
+	return code
+
+
 func _leaf_binding_refusal(expected_revision: int, owner_token: int = 0) -> StringName:
 	"""Recheck the already-attested exact actual wiring from leaf facts, with no source-provider read."""
 	var space: Owner = _space.get_ref() as Owner if _space != null else null
