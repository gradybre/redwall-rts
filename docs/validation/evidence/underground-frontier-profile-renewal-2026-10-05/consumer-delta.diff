+static func _frontier_mask_shapes(actual: RefCounted, graph: Routes) -> bool:
+	"""Both exact certificate banks remain bounded before any final selected-bit or retained-mask read."""
+	if not Routes._frontier_shapes(graph): return false
+	return _frontier_mask_shape(actual._live) and _frontier_mask_shape(actual._stage)
+
+
+static func _frontier_mask_shape(bank: Certificates) -> bool:
+	"""No shortened certificate packet can turn a stale candidate into an invalid indexed access."""
+	return bank != null and bank.masks.size() == EDGE_CAPACITY * MASK_BYTES and bank.generations.size() == EDGE_CAPACITY \
+		and bank.geometry.size() == EDGE_CAPACITY and bank.content.size() == EDGE_CAPACITY
+
+
+static func _frontier_old_masks(actual: RefCounted, graph: Routes) -> StringName:
+	"""Unchanged Space and sources must preserve every complete old certificate byte, not merely one useful bit."""
+	for row: int in graph._edge_capacity:
+		if graph._live.present[row] == 0: continue
+		if actual._live.generations[row] != actual._stage.generations[row] \
+				or actual._live.geometry[row] != actual._stage.geometry[row] \
+				or actual._live.content[row] != actual._stage.content[row]: return &"WORLD_ROUTE_FRONTIER_OLD_MASK"
+		for index: int in MASK_BYTES:
+			if actual._live.masks[row * MASK_BYTES + index] != actual._stage.masks[row * MASK_BYTES + index]:
+				return &"WORLD_ROUTE_FRONTIER_OLD_MASK"
+	return &""
