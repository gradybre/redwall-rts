+	var row: int = _residents.directory().get_typed_row(_worker)
+	_routes._motion.resident_long[Routes.R_REMAINDER * Routes.RESIDENT_CAPACITY + row] = Routes._encode_fraction(29, 30)
+	assert_equal(_routes.request_route(_worker, last, 0), &"", "explicit saved original fraction")
+	var actor: Routes.Actor = Routes.Actor.new()
