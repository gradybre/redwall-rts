+static func frontier_leaf_refusal(actual: RefCounted, context: Locations.FrontierContext) -> StringName:
+	"""One exact sealed add-only Location/graph/mask tuple preserves the same paid Space and all old exits."""
+	if actual == null or context == null or context.routes != actual or actual._budget != context.budget \
+			or actual._route_token <= 0 or actual._route_token != context.route_token \
+			or actual._location_token != context.location_token or actual._space_token != 0 \
+			or actual._cold_token != context.cold or actual._base_revision != context.revision \
+			or actual._target_revision != context.revision or actual._content_revision != context.profiles \
+			or actual._catalog_revision != context.catalog or actual._live != context.masks_live \
+			or actual._stage != context.masks_candidate or not actual._sealed or actual._proof != null \
+			or actual._opening or actual._compiling or actual._publishing or actual._reading: return REFUSE_CONTEXT
+	var graph: Routes = context.graph as Routes
+	if graph == null or actual._routes_ref == null or actual._routes_ref.get_ref() != graph: return REFUSE_BINDING
+	var code: StringName = _reach_stores_refusal(actual, graph, context.owner, context.locations)
+	if code == &"": code = _reach_content_refusal(actual)
+	if code == &"": code = Locations.frontier_rows_refusal(context.locations, context)
+	if code == &"": code = Routes.frontier_leaf_refusal(graph, context)
+	if code == &"": code = _prepared_masks_refusal(actual, graph, context.revision, context.profiles)
+	if code == &"": code = _frontier_old_masks(actual, graph)
+	return code
+
+
+static func _frontier_old_masks(actual: RefCounted, graph: Routes) -> StringName:
+	"""Unchanged Space and sources must preserve every complete old certificate byte, not merely one useful bit."""
+	for row: int in graph._edge_capacity:
+		if graph._live.present[row] == 0: continue
+		if actual._live.generations[row] != actual._stage.generations[row] \
+				or actual._live.geometry[row] != actual._stage.geometry[row] \
+				or actual._live.content[row] != actual._stage.content[row]: return &"WORLD_ROUTE_FRONTIER_OLD_MASK"
+		for index: int in MASK_BYTES:
+			if actual._live.masks[row * MASK_BYTES + index] != actual._stage.masks[row * MASK_BYTES + index]:
+				return &"WORLD_ROUTE_FRONTIER_OLD_MASK"
+	return &""
+
+
+static func commit_frontier_preflighted(actual: RefCounted, context: Locations.FrontierContext) -> bool:
+	"""Only the coordinator's callback-free final window can execute all three already validated bank swaps."""
+	if actual == null or context == null or not actual._publishing or actual._opening or actual._compiling \
+			or actual._reading or actual != context.routes or context.locations._frontier != context \
+			or actual._route_token != context.route_token or context.graph._token != context.route_token \
+			or context.locations._token != context.location_token: return false
+	Locations.commit_frontier_preflighted(context.locations, context)
+	Routes._commit_preflighted_bank(context.graph, context.route_token)
+	_commit_preflighted_certificates(actual, context.catalog)
+	return true
