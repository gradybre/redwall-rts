+	if code == &"": code = _frontier_order_refusal(actual)
+	if code == &"": code = Locations.frontier_heap_refusal(actual._live.free_rows, actual._stage.free_rows,
+		actual._live.free_count, context.edges, 2 * context.count, heap_patch, true)
+	return _frontier_new_rows(actual, context) if code == &"" else code
+
