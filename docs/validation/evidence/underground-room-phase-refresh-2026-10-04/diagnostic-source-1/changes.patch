+	if owner._r_owner_slot[section.x] != source.x or owner._r_owner_generation[section.x] != source.y \
+			or (room == NULL_REF and bank.i32[LEVEL * capacity + row] != 0): return &"LOCATION_SECTION_STALE"
+	return _iteration_source_refusal(actual, source, section.x)
