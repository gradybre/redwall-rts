# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
*.egg-info/
dist/
build/

# Environment
.env

# Godot
# Only the engine cache is ignored: in Godot 4 the .import and .uid files carry
# asset UIDs and must be committed, or a fresh clone regenerates different ones.
godot/.godot/
godot/export_presets.cfg

# Blender
*.blend1
*.blend2

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Claude Code agent worktrees (each agent gets its own .godot import cache)
.claude/worktrees/

# Provisional Meshy asset library: binaries live on local disk, the ledger is committed (docs/art-reference/asset_library/, decision 0188)
assets/library/

# Live demo: staged from the provisional asset library by tools/stage_demo_assets.py (decision 0196)
godot/demo/assets/
# The Windows build's version file, written and removed by tools/build_demo_windows.py (decision 0562)
godot/demo/build_info.json
