```sh
python3 -B docs/validation/evidence/underground-room-phases-2026-10-04/reproduce.py --out docs/validation/evidence/underground-room-phases-2026-10-04/replay-new --port 6353 --suite test_underground_room_world_phases.gd --suite test_underground_work_face.gd
