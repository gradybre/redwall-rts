+func _bar_submit(out: SubmitResult) -> bool:
+	"""Report a barred admission without touching a counter, a row or `_refused_member`.
+
+	Deliberately NOT `_refuse()`: SAVE-P2-R02 refuses before any refusal counter moves, because a
+	command stopped by the barrier was never an admission against this world at all.
+	"""
+	_last_refusal = REFUSE_LOAD_BARRIER
+	out.fill(false, REFUSE_LOAD_BARRIER, 0, _refused_member)
+	return false
