+def declaration_blocks(text):
+    """Capture complete top-level declarations through continuation lines."""
+    result = []
+    for match in re.finditer(r'^(?:static var|var|const) [^\n]*(?:\n[ \t]+[^\n]*)*', text, re.M):
+        result.append(match[0].rstrip())
+    return result
+
+
+def nested_declarations(text, name):
+    chunk = text.split('class ' + name + ' extends RefCounted:\n', 1)[1]
+    chunk = re.split(r'^\S', chunk, maxsplit=1, flags=re.M)[0]
+    return declaration_blocks(re.sub(r'^\t', '', chunk, flags=re.M))
+
+
+def collection_refusal(name, row):
+    """No uncharged inline, typed or constructor-created collection is a scalar slot."""
+    code = re.sub(r'""".*?"""|#[^\n]*', '', row['body'], flags=re.S)
+    code = re.sub(r'&?"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'', '""', code)
+    require(all(kind not in ('Array', 'Dictionary', 'Variant') and not kind.startswith('Packed')
+                for _, kind in row['values']), 'unbounded constructor local: ' + name)
+    require(not re.search(r'\b(?:Packed\w+Array|Dictionary|Array(?:\[[^\]]+\])?)\s*\(', code),
+            'uncharged collection constructor: ' + name)
+    # Indexed reads have an identifier, dot, close bracket or close parenthesis
+    # before '['. A bracket after an operator/comma/opening delimiter/return is
+    # a collection literal and needs an explicit lifetime/payload census.
+    literals = re.findall(r'(?<![\w.\]\)])\[[^\]]*\]', code)
+    permitted = []
+    if name == 'Owner._read_source':
+        permitted = ['[Directory.KIND_WORLD, Directory.KIND_BUILDING, Directory.KIND_ROOM, '
+                     'Directory.KIND_FURNITURE, Directory.KIND_CONSTRUCTION, Directory.KIND_RESIDENT]']
+    require([' '.join(value.split()) for value in literals] == permitted and '{' not in code,
+            'uncharged collection literal: ' + name)
+
+
+def allocation_signature(row):
+    """Detect new collection locals, inline constructors and literal payloads in all own methods."""
+    code = re.sub(r'""".*?"""|#[^\n]*', '', row['body'], flags=re.S)
+    code = re.sub(r'&?"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'', '""', code)
+    types = [(name, kind) for name, kind in row['values']
+             if kind in ('Array', 'Dictionary', 'Variant') or kind.startswith('Packed')]
+    constructors = re.findall(r'\b(?:Packed\w+Array|Dictionary|Array(?:\[[^\]]+\])?)\s*\(', code)
+    literals = [' '.join(value.split()) for value in re.findall(r'(?<![\w.\]\)])\[[^\]]*\]|\{[^}]*\}', code)]
+    return types, constructors, literals
+
