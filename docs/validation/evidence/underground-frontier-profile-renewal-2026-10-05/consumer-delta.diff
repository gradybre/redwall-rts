+static func commit_frontier_preflighted(actual: RefCounted, context: Locations.FrontierContext) -> bool:
+	"""Only the coordinator's callback-free final window can execute all three already validated bank swaps."""
+	if actual == null or context == null or not actual._publishing or actual._opening or actual._compiling \
+			or actual._reading or actual != context.routes or context.locations._frontier != context \
+			or actual._route_token != context.route_token or context.graph._token != context.route_token \
+			or context.locations._token != context.location_token: return false
+	Locations.commit_frontier_preflighted(context.locations, context)
+	Routes._commit_preflighted_bank(context.graph, context.route_token)
+	_commit_preflighted_certificates(actual, context.catalog)
+	return true
