; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be manually edited if needed.

config_version=5

[application]

config/name="Redwall RTS"
config/description="A Redwall-inspired RTS colony-builder"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EntityManager="*res://scripts/systems/entity_manager.gd"
GameManager="*res://scripts/systems/game_manager.gd"
SettlementSystem="*res://scripts/systems/settlement_system.gd"
EconomySystem="*res://scripts/systems/economy_system.gd"
UIManager="*res://scripts/systems/ui_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
; SET-UX-VIS-002 / UI 1.2: the UI lays out against the ACTUAL viewport, so the responsive
; profiles key off a logical width that changes with the window. "canvas_items" against a
; fixed 1920x1080 base gave every window a 1920x1080 logical size -- measured: a 1280x720
; window still resolved to WIDE -- which made UI 1.2's NARROW composition unreachable at
; runtime and testable only in isolation. Astra ruled the correction in the READY_07
; save/UI addendum: disable automatic base stretching and let the UI own its own scale.
window/stretch/mode="disabled"
window/stretch/aspect="expand"

[input]

; UI/UX controls rev 1.1, section 5 "Complete Input Map and Interaction Precedence".
; Every action ID below is quoted verbatim from that table. Section 5 also rules that
; pointer-derived gestures (box selection, double-click, shift-toggle, queue, placement
; repeat) are semantic actions EMITTED BY AN INPUT ROUTER after classifying one pointer
; event, and "must not each execute independently from duplicate raw mouse bindings".
; No input router exists in this project yet, so no pointer gesture is bound as a raw
; mouse event here; only the mouse wheel, which is one discrete event meaning one action.
;
; Godot matches a key action when the action's modifier mask is a SUBSET of the pressed
; event's mask (verified against 4.7.2), so a plain-key action also fires while Ctrl,
; Shift or Alt is held. Ctrl+3 therefore raises group_assign_3 AND group_recall_3. That
; is the router's "modifier gesture before plain" precedence to resolve, not a binding
; error; test_input_map.gd pins the exact set of pairs so a new one cannot appear
; unnoticed.

; Camera pan --- UI 5: "WASD; arrow keys outside editing/tools", and
; A/Left->left, D/Right->right, W/Up->forward, S/Down->back. WASDQE use
; physical_keycode ("physical key positions for WASD/QE movement"); every
; other binding uses the logical keycode. Edge scroll, middle drag and
; Option/Alt+left drag are router-classified drags, deliberately unbound here.

