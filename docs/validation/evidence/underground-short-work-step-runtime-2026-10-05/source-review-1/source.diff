+func test_short_interruption_and_source_corruption_cannot_restart_or_extend_the_prefix() -> void:
+	"""A refused real movement tick preserves the exact fraction/source time and resumes only the same original span."""
+	_clock_profiles(NULL_REF, false, 6)
+	_binding.synthetic_pace = 3277
+	var a: Vector3i = Vector3i(-512, 0, 512)
+	var first: Vector2i = _location(a)
+	var last: Vector2i = _location(a + Vector3i(232, 0, 0))
+	_publish_edges([_edge(first, last, [a, a + Vector3i(232, 0, 0)])])
+	assert_equal(_routes.admit_travel_actor(_worker, NULL_REF, first, 10, 1, 3, 0, -1), &"", "fresh finite state")
+	assert_equal(_routes.request_route(_worker, last, 0), &"", "original request")
+	for tick: int in range(1, 10): assert_equal(_routes.advance_tick(tick), 1, "complete entry and first root tick")
+	var before: PackedByteArray = _routes._motion.resident_long.to_byte_array()
+	var pose: PackedByteArray = _transforms.state_bytes()
+	_binding.motion_blocked = true
+	assert_equal(_routes.advance_tick(10), 0, "actual movement observer blocks")
+	assert_equal(_routes._motion.resident_long.to_byte_array(), before, "clock/progress/fraction not reset")
+	assert_equal(_transforms.state_bytes(), pose, "root not advanced")
+	assert_true(_routes.request_route(_worker, last, 10) != &"", "held prefix is not a new admission")
+	_binding.motion_blocked = false
+	for tick: int in range(11, 21): assert_equal(_routes.advance_tick(tick), 1, "resume exact remaining prefix/recovery")
+	assert_equal(Routes.source_ready_leaf_refusal(_routes, _worker, NULL_REF, 10, 1, 3), &"", "same accepted-tick terminal")
+	_short_clock_mutants()
