+static func _iteration_source_refusal(actual: RefCounted, ref: Vector2i, section: int) -> StringName:
+	"""A full source row and its actual mirrored identity must agree at the current section revision."""
+	var owner: Owner = actual._owner
+	var found: int = -1
+	for row: int in owner._source_capacity:
+		if owner._o_present[row] == 0 or owner._o_slot[row] != ref.x: continue
+		if owner._o_present[row] != 1 or owner._o_generation[row] != ref.y or found >= 0: return &"LOCATION_SOURCE_STALE"
+		found = row
+	if found < 0 or owner._o_revision[found] <= 0 or owner._o_revision[found] != owner._r_owner_revision[section] \
+			or owner._o_b[found] != 0 or owner._o_c[found] != 0: return &"LOCATION_SOURCE_STALE"
