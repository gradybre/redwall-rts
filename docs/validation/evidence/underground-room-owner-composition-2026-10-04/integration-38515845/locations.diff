+static func _frontier_ordinal(context: FrontierContext, ref: Vector2i) -> int:
+	"""Only one of the exact original fixed full refs may be read as a prospective endpoint."""
+	for index: int in context.count:
+		if Vector2i(context.refs[index * 2], context.refs[index * 2 + 1]) == ref: return index
+	return -1
