+
+## Additional retirement-only logical/provisional slice inside unchanged PROFILE_BYTES; native costs are unmeasured.
+const RETIREMENT_RESERVED_BYTES: int = 8192
+const NULL_REF: Vector2i = Vector2i(-1, 0)
+
+
+class Owners extends RefCounted:
+	## Fixed caller packet. The actual host proves these are its mounted Session's owners before prepare_into.
+	var world_ref: Vector2i = Vector2i(-1, 0)
+	var world: World = null
+	var directory: Directory = null
+	var buildings: Buildings = null
