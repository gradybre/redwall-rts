+static func frontier_record_matches(actual: RefCounted, context: FrontierContext, ref: Vector2i, record: Record) -> bool:
+	"""Compare the full prospective payload using current actual packed columns, with no observing reader."""
+	if frontier_scope_refusal(actual, context) != &"" or record == null or not actual._live_ref(actual._stage, ref): return false
+	var row: int = ref.x
+	if record.world != context.world or record.point != Vector3i(actual._get32(actual._stage, X, row), \
+			actual._get32(actual._stage, Y, row), actual._get32(actual._stage, Z, row)) \
+			or record.room != actual._ref_at(actual._stage, ROOM_SLOT, row) \
+			or record.section != actual._ref_at(actual._stage, SECTION_SLOT, row) \
+			or record.level != actual._get32(actual._stage, LEVEL, row) or record.role != actual._get32(actual._stage, ROLE, row) \
+			or record.geometry_revision != context.revision \
+			or record.payload_revision != actual._get64(actual._stage, PAYLOAD_REVISION, row): return false
+	for axis: int in 6:
+		if record.envelope[axis] != actual._get32(actual._stage, ENVELOPE + axis, row) \
+				or record.support[axis] != actual._get32(actual._stage, SUPPORT + axis, row): return false
+	return true
