+		assert_equal(actor.point.x, first_point.x + distance, "exact original rational root law")
+	assert_equal(_routes._motion.resident_long[Routes.R_REMAINDER * Routes.RESIDENT_CAPACITY + row], 0, "terminal consumes exactly endpoint time")
+	assert_equal(Routes.source_ready_leaf_refusal(_routes, _worker, NULL_REF, 10, 1, 3), &"", "full recovered source")
