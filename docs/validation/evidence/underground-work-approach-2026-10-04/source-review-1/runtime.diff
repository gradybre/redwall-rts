+func test_source_clock_refusal_and_interruption_preserve_phase_for_exact_retry() -> void:
+	"""A blocked real-owner observation pauses source time; retry equals uninterrupted accepted-tick progression."""
+	_clock_profiles()
+	var a: Vector3i = Vector3i(-512, 0, 512)
+	var b: Vector3i = Vector3i(512, 0, 512)
+	var first: Vector2i = _location(a)
+	var last: Vector2i = _location(b)
+	_publish_edges([_edge(first, last, [a, b])])
+	assert_equal(_routes.admit_travel_actor(_worker, NULL_REF, first, 5, 1, 2, 0, -1), &"", "actual source actor")
+	assert_equal(_routes.request_route(_worker, last, 0), &"", "real queued edge")
+	for tick: int in range(1, 4): _routes.advance_tick(tick)
+	var row: int = _residents.directory().get_typed_row(_worker)
+	var clock: int = _routes._motion.resident_long[Routes.R_REQUEST_TICK * Routes.RESIDENT_CAPACITY + row]
+	var state: PackedInt64Array = PackedInt64Array([99, 98, 97, 96])
+	_binding.refusal = &"SYNTHETIC_SOURCE_STOP"
+	assert_equal(_routes.advance_tick(4), 0, "actual provider stops before phase write")
+	assert_equal(_routes._motion.resident_long[Routes.R_REQUEST_TICK * Routes.RESIDENT_CAPACITY + row], clock, "no lost or accumulated source time")
+	assert_equal(_routes.actor_phase(_worker), Routes.PHASE_HELD, "only geometric hold changes")
+	_binding.refusal = &""
+	for tick: int in range(5, 10): assert_equal(_routes.advance_tick(tick), 1, "same original phase resumes")
+	assert_equal(_routes.source_state_into(_worker, NULL_REF, 5, 1, 2, state), &"", "current immutable source tuple")
+	assert_equal(state, PackedInt64Array([Routes.SourceProgram.WALK, 0, 0, Routes.PHASE_QUEUED]), "eight accepted ticks match uninterrupted fade")
+	var word: int = _routes._motion.resident[Routes.R_PHASE * Routes.RESIDENT_CAPACITY + row]
+	_routes._motion.resident[Routes.R_PHASE * Routes.RESIDENT_CAPACITY + row] = word | 64
+	assert_equal(_routes.source_state_into(_worker, NULL_REF, 5, 1, 2, state), &"ROUTE_SOURCE_TUPLE_STALE", "reserved tag refuses")
+	assert_equal(Routes.actor_phase_in(_routes, _worker), Routes.PHASE_ABSENT, "malformed tag cannot look stationary")
+	assert_equal(state[0], Routes.SourceProgram.WALK, "refused read leaves prior output")
+	_routes._motion.resident[Routes.R_PHASE * Routes.RESIDENT_CAPACITY + row] = word
+	_routes._motion.resident_long[Routes.R_REQUEST_TICK * Routes.RESIDENT_CAPACITY + row] = 2147483648
+	assert_equal(_routes.source_state_into(_worker, NULL_REF, 5, 1, 2, state), &"ROUTE_SOURCE_TUPLE_STALE", "reserved Q16 high bit refuses")
+	_routes._motion.resident_long[Routes.R_REQUEST_TICK * Routes.RESIDENT_CAPACITY + row] = 0
+	assert_equal(_routes.source_state_into(Vector2i(_worker.x, _worker.y + 1), NULL_REF, 5, 1, 2, state), &"ROUTE_SOURCE_TUPLE_STALE", "full worker generation")
+	assert_equal(_routes.source_state_into(_worker, NULL_REF, 5, 2, 2, state), &"ROUTE_SOURCE_TUPLE_STALE", "original profile revision")
+	assert_equal(_routes.source_state_into(_worker, NULL_REF, 5, 1, 2, state), &"", "valid original tuple still works")
+
