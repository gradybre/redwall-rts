bytes: int = _required_bytes(locations.packed_memory_bytes(), nodes, edges, vertices, links)\n\tif arena_bytes > ARENA_BYTES or arena_bytes < bytes:\n\t\treturn &"ROUTE_ARENA_CAPACITY"\n\t_bind_stores(locations, owner, sources, buildings, cold, bindings)\n\treturn _configure_arenas(nodes, edges, vertices, links)\n\n\nfunc _bind_stores(locations: Locations, owner: Owner, sources: Owner.CoreSources,\n\t\tbuildings: Buildings, cold: Budget, bindings: Bindings) -> void:\n\t"""Borrow graph collaborators weakly wherever CoreSources can retain this actual Routes instance."""\n\t_locations = locations\n\t_owner = owner\n\t_sources = sources\n\t_buildings = buildings\n\t_cold = cold\n\t_bindings = bindings\n\t_world = locations.world_ref()\n\t_domain = owner.domain_copy()\n\n\nfunc _configure_arenas(nodes: int, edges: int, vertices: int, links: int) -> StringName:\n\t"""Install the exact endpoint observer before allocating pre-admitted fixed graph/actor banks."""\n\t_location_capacity = nodes\n\t_edge_capacity = edges\n\t_vertex_capacity = vertices\n\t_link_capacity = links\n\t_retention = EndpointRetention.new(self)\n\tvar code: StringName = _locations.bind_retention(_retention)\n\tif code != &"":\n\t\t_edge_capacity = 0\n\t\treturn code\n\t_allocate()\n\treturn &""\n\n\nfunc retention_binding_matches(locations: RefCounted) -> bool:\n\t"""Read only the exact retained namespace, without consulting geometry or re-entering Locations."""\n\treturn _edge_capacity > 0 and locations != null and locations == _locations\n\n\nfunc retains_location(location: Vector2i) -> bool:\n\t"""Immutable endpoints remain retained by live spans and actors, even when entry proofs expire."""\n\tif _edge_capacity == 0:\n\t\treturn false\n\tfor row: int in _edge_capacity:\n\t\tif _live.present[row] != 0 and (_edge_pair(_live, E_FROM_SLOT, row) == location \\\n\t\t\t\tor _edge_pair(_live, E_TO_SLOT, row) == location):\n\t\t\treturn true\n\tfor row: int in RESIDENT_CAPACITY:\n\t\tif _resident_pair(R_LOCATION_SLOT, row) == location:\n\t\t\treturn true\n\treturn false\n\n\nstatic func _required_bytes(location_bytes: int, nodes: int, edges: int, vertices: int, links: int) -> int:\n\t"""All scalar arguments are bounded before this arithmetic; no independent maximum grants extra bytes."""\n\treturn location_bytes + 180 * edges + 24 * vertices + 312 * RESIDENT_CAPACITY + 40 * links \\\n\t\t+ 12 * vertices + 33 * nodes + 48 * RESIDENT_CAPACITY + HEADER_RESERVE\n\n\nfunc packed_memory_bytes() -> int:\n\t"""Report all retained packed arrays, including fixed query packets within the control reservation."""\n\tif _edge_capacity == 0:\n\t\treturn 0\n\treturn _required_bytes(0, _location_capacity, _edge_capacity, _vertex_capacity, _link_capacity) \\\n\t\t- HEADER_RESERVE + FIXED_PACKED_BYTES\n\n\nfunc _allocate() -> void:\n\t"""One finite allocation per column; no per-resident route Array or retained graph object."""\n\t_live.allocate(_edge_capacity, _vertex_capacity)\n\t_stage.allocate(_edge_capacity, _vertex_capacity)\n\t_motion.allocate(_link_capacity)\n\t_load_motion.allocate(_link_capacity)\n\t_distance.resize(_location_capacity)\n\t_predecessor.resize(_location_capacity)\n\t_heap_node.resize(_location_capacity)\n\t_heap_position.resize(_location_capacity)\n\t_search_state.resize(_location_capacity)\n\t_proposed_edges.resize(2 * _location_capacity)\n\t_occupancy_heads.resize(_location_capacity)\n\t_occupancy_next.resize(RESIDENT_CAPACITY)\n\t_occupancy_cell.resize(3 * RESIDENT_CAPACITY)\n\t_occupancy_visit.resize(RESIDENT_CAPACITY)\n\t_occupancy_bounds.resize(6 * RESIDENT_CAPACITY)\n\t_occupancy_profile.resize(RESIDENT_CAPACITY)\n\t_occupancy_heads.fill(-1)\n\t_occupancy_next.fill(-1)\n\t_occupancy_expected_revision = _transforms.mutation_revision()\n\t_edge.points.resize(3 * _vertex_capacity) # One explicitly charged reusable whole-edge packet; decision1075.\n\n\nfunc bind_profiles(profiles: Profiles, inventory: Inventory, gear: Gear, carry: Carry,\n\t\twork: Work, reservations: Reservations, piles: Piles) -> StringName:\n\t"""Attest every actual profile collaborator before retaining its exact immutable-query owner."""\n\tif _reject_callback() or _profiles != null or _ids == null:\n\t\treturn &"ROUTE_PROFILES_ALREADY_BOUND"\n\tif profiles == null or work == null or not profiles.binding_matches(_residents, _transforms,\n\t\t\tinventory, gear, carry, work, reservations, piles):\n\t\treturn &"ROUTE_PROFILE_OWNER_MISMATCH"\n\t_profiles = profiles\n\t_work = work\n\t_jobs = work.jobs()\n\treturn refresh_profile_extent() if profiles.content_revision() > 0 else &""\n\n\nfunc binding_matches(residents: Residents, transforms: Transforms, locations: Locations,\n\t\towner: Owner, cold: Budget, profiles: Profiles) -> bool:\n\t"""The World composer must share exact instances, including its actual Residents/Profile namespace."""\n\treturn _edge_capacity > 0 and _residents == residents and _transforms == transforms \\\n\t\tand _locations == locations and _owner == owner and _cold == cold and profiles != null \\\n\t\tand _profiles == profiles and _world != NULL_REF and _ids.is_valid_of_kind(_world, Directory.KIND_WORLD)\n\n\nfunc read_into(worker: Vector2i, out: Owner.Facts) -> StringName:\n\t"""CoreSources receives real transform, mode and containing Room, never a flat tile or guessed level."""\n\tif out == null:\n\t\treturn &"ROUTE_OUTPUT_REQUIRED"\n\tvar code: StringName = read_actor_into(worker, _actor)\n\tif code != &"":\n\t\treturn code\n\tout.kind = Directory.KIND_RESIDENT\n\tout.parent = _actor.room\n\tout.a = _actor.point.x\n\tout.b = _actor.point.y\n\tout.c = _actor.point.z\n\tout.d = _actor.mode\n\treturn &""\n\n\nfunc read_actor_into(worker: Vector2i, out: Actor) -> StringName:\n\t"""Read one actual committed actor at its exact full identity; there is no surface fallback."""\n\tif out == null or _edge_capacity == 0 or _profiles == null or _work == null or _work.jobs() != _jobs:\n\t\treturn &"ROUTE_ACTOR_UNBOUND"\n\tif not _ids.is_valid_of_kind(worker, Directory.KIND_RESIDENT) or not _transforms.read_into(worker, _pose):\n\t\treturn &"ROUTE_ACTOR_STALE"\n\tvar row: int = _ids.get_typed_row(worker)\n\tif _resident_ref(row) != worker or not _residents.is_alive(row):\n\t\treturn &"ROUTE_ACTOR_NOT_REGISTERED"\n\tvar code: StringName = _actor_location_refusal(row)\n\tif code == &"":\n\t\tcode = _source_clock_refusal(row)\n\tif code != &"":\n\t\treturn code\n\t_write_actor(row, worker, out)\n\treturn &""\n\n\nfunc _resident_ref(row: int) -> Vector2i:\n\t"""A typed row alone never qualifies the occupant that previously owned it."""\n\treturn Vector2i(_motion.resident[R_SLOT * RESIDENT_CAPACITY + row],\n\t\t_motion.resident[R_GENERATION * RESIDENT_CAPACITY + row])\n\n\nfunc _resident_pair(field: int, row: int) -> Vector2i:\n\t"""Copy one packed full reference; pairs always retain distinct external/local namespaces."""\n\treturn Vector2i(_motion.resident[field * RESIDENT_CAPACITY + row],\n\t\t_motion.resident[(field + 1) * RESIDENT_CAPACITY + row])\n\n\nfunc _actor_location_refusal(row: int) -> StringName:\n\t"""Endpoints own idle containment; occupied-edge containment is validated by actual route progress."""\n\tvar location: Vector2i = _resident_pair(R_LOCATION_SLOT, row)\n\tvar code: StringName = _locations.read_location_into(location, _first)\n\tif code != &"":\n\t\treturn code\n\tif _first.world != _world or not _owner.is_live_region(_resident_pair(R_SECTION_SLOT, row)):\n\t\treturn &"ROUTE_LOCATION_STALE"\n\tvar room: Vector2i = _resident_pair(R_ROOM_SLOT, row)\n\tif room != NULL_REF and not _buildings.is_live_room(room):\n\t\treturn &"ROUTE_LOCATION_STALE"\n\tif _resident_pair(R_EDGE_SLOT, row) != NULL_REF:\n\t\treturn _transit_identity_refusal(row)\n\tif _first.point != Vector3i(_pose.x, _pose.y, _pose.z):\n\t\treturn &"ROUTE_ACTOR_POSITION_DRIFT"\n\tif _first.room != room or _first.section != _resident_pair(R_SECTION_SLOT, row) \\\n\t\t\tor _first.level != _motion.resident[R_LEVEL * RESIDENT_CAPACITY + row]:\n\t\treturn &"ROUTE_ACTOR_CONTAINMENT_DRIFT"\n\treturn &""\n\n\nfunc _write_actor(row: int, worker: Vector2i, out: Actor) -> void:\n\t"""Only a fully validated observation writes caller scratch; the output owns no authoritative arrays."""\n\tout.worker = worker\n\tout.job = _resident_pair(R_JOB_SLOT, row)\n\tout.location = _resident_pair(R_LOCATION_SLOT, row)\n\tout.edge = _resident_pair(R_EDGE_SLOT, row)\n\tout.room = _resident_pair(R_ROOM_SLOT, row)\n\tout.section = _resident_pair(R_SECTION_SLOT, row)\n\tout.level = _motion.resident[R_LEVEL * RESIDENT_CAPACITY + row]\n\tout.point = Vector3i(_pose.x, _pose.y, _pose.z)\n\tout.yaw = _pose.yaw\n\tout.mode = _motion.resident[R_MODE * RESIDENT_CAPACITY + row]\n\tout.posture = _motion.resident[R_POSTURE * RESIDENT_CAPACITY + row]\n\tout.phase = _route_phase_at(row)\n\tout.profile_id = _motion.resident[R_PROFILE * RESIDENT_CAPACITY + row]\n\tout.profile_revision = _motion.resident_long[R_PROFILE_REVISION * RESIDENT_CAPACITY + row]\n\tout.content_revision = _motion.resident_long[R_CONTENT_REVISION * RESIDENT_CAPACITY + row]\n\tout.tool = _resident_pair(R_TOOL_SLOT, row)\n\tout.cargo = _resident_pair(R_CARGO_SLOT, row)\n\tout.satchel = _resident_pair(R_SATCHEL_SLOT, row)\n\tout.cargo_quantity_milli = _motion.resident_long[R_QUANTITY * RESIDENT_CAPACITY + row]\n\n\nfunc at_contact_refusal(worker: Vector2i, job: Vector2i, location: Vector2i,\n\t\tselection: Profiles.Selection) -> StringName:\n\t"""Prove actual arrival and re-read actual profile/load; a mutable caller Selection grants no permission."""\n\tvar code: StringName = read_actor_into(worker, _actor)\n\tif code != &"":\n\t\treturn code\n\tif selection == null or _actor.edge != NULL_REF or _actor.phase != PHASE_IDLE \\\n\t\t\tor _actor.location != location or _actor.job != job:\n\t\treturn &"ROUTE_CONTACT_NOT_REACHED"\n\tif _first.geometry_revision != _owner.revision():\n\t\treturn &"ROUTE_CONTACT_GEOMETRY_STALE"\n\tif not _ids.is_valid_of_kind(job, Directory.KIND_JOB) or _jobs.job_of(_ids.get_typed_row(worker)) != job \\\n\t\t\tor _jobs.worker_of(_ids.get_typed_row(job)) != worker:\n\t\treturn &"ROUTE_CONTACT_JOB_STALE"\n\tvar row: int = _ids.get_typed_row(worker)\n\tcode = _current_profile_into(row, _selection)\n\tif code != &"":\n\t\treturn code\n\tif not _same_selection(selection, _selection) or not _committed_selection(row, _selection):\n\t\treturn &"ROUTE_CONTACT_PROFILE_STALE"\n\treturn &""\n\n\nstatic func _same_selection(first: Profiles.Selection, second: Profiles.Selection) -> bool:\n\t"""Compare every observed key, content identity and current actual pose/ownership field."""\n\treturn first.profile_id == second.profile_id and first.profile_revision == second.profile_revision \\\n\t\tand first.content_revision == second.content_revision and first.source_id == second.source_id \\\n\t\tand first.species == second.species and first.life_stage == second.life_stage and first.rig == second.rig \\\n\t\tand first.mode == second.mode and first.posture == second.posture and first.orientation == second.orientation \\\n\t\tand first.x == second.x and first.y == second.y and first.z == second.z and first.yaw == second.yaw \\\n\t\tand first.worker == second.worker and first.job == second.job and first.tool == second.tool \\\n\t\tand first.cargo == second.cargo and first.satchel == second.satchel \\\n\t\tand first.cargo_quantity_milli == second.cargo_quantity_milli and first.box_count == second.box_count\n\n\nfunc _committed_selection(row: int, selection: Profiles.Selection) -> bool:\n\t"""Entry/load changes require explicit requalification; the prior profile cannot follow new cargo silently."""\n\treturn selection.worker == _resident_ref(row) and selection.job == _resident_pair(R_JOB_SLOT, row) \\\n\t\tand selection.profile_id == _motion.resident[R_PROFILE * RESIDENT_CAPACITY + row] \\\n\t\tand selection.profile_revision == _motion.resident_long[R_PROFILE_REVISION * RESIDENT_CAPACITY + row] \\\n\t\tand selection.content_revision == _motion.resident_long[R_CONTENT_REVISION * RESIDENT_CAPACITY + row] \\\n\t\tand selection.mode == _motion.resident[R_MODE * RESIDENT_CAPACITY + row] \\\n\t\tand selection.posture == _motion.resident[R_POSTURE * RESIDENT_CAPACITY + row] \\\n\t\tand selection.tool == _resident_pair(R_TOOL_SLOT, row) and selection.cargo == _resident_pair(R_CARGO_SLOT, row) \\\n\t\tand selection.satchel == _resident_pair(R_SATCHEL_SLOT, row) \\\n\t\tand selection.cargo_quantity_milli == _motion.resident_long[R_QUANTITY * RESIDENT_CAPACITY + row]\n\n\nfunc _edge_i32(bank: EdgeBank, field: int, row: int) -> int:\n\t"""Read a single bounded packed field; all callers validate row identity first."""\n\treturn bank.fields[field * _edge_capacity + row]\n\n\nfunc _set_edge_i32(bank: EdgeBank, field: int, row: int, value: int) -> void:\n\t"""Write only an admitted int32 field into the selected private bank."""\n\tbank.fields[field * _edge_capacity + row] = value\n\n\nfunc _edge_i64(bank: EdgeBank, field: int, row: int) -> int:\n\t"""Revision/path-length fields retain int64 range independently of XYZ bounds."""\n\treturn bank.longs[field * _edge_capacity + row]\n\n\nfunc _edge_pair(bank: EdgeBank, field: int, row: int) -> Vector2i:\n\t"""Endpoint/Room namespaces remain distinct even when their integer pairs coincide."""\n\treturn Vector2i(bank.fields[field * _edge_capacity + row], bank.fields[(field + 1) * _edge_capacity + row])\n\n\nfunc _live_edge(bank: EdgeBank, ref: Vector2i) -> bool:\n\t"""An authored path is identified by its full local generation, never its recycled row alone."""\n\treturn ref.x >= 0 and ref.x < _edge_capacity and ref.y > 0 and bank.present[ref.x] == 1 \\\n\t\tand bank.fields[E_GENERATION * _edge_capacity + ref.x] == ref.y\n\n\nfunc is_live_edge(ref: Vector2i) -> bool:\n\t"""Liveness is identity evidence; traversal additionally requires current physical and profile proof."""\n\treturn _edge_capacity > 0 and _live_edge(_live, ref)\n\n\nfunc revision() -> int:\n\t"""Authored topology has a separate revision from physical-space and immutable profile content."""\n\treturn _live.revision if _edge_capacity > 0 else 0\n\n\nfunc _binding_refusal() -> StringName:\n\t"""Revalidate exact actual instances and live World before any public route mutation."""\n\tif _edge_capacity == 0 or _profiles == null or _ids == null or _locations == null \\\n\t\t\tor _owner == null or _sources == null or _bindings == null or _work == null \\\n\t\t\tor not _ids.is_valid_of_kind(_world, Directory.KIND_WORLD):\n\t\treturn &"ROUTE_OWNER_UNBOUND"\n\tif not _locations.is_bound_world(_ids, _world, _owner) or not _locations.is_bound_budget(_cold) \\\n\t\t\tor not _owner.is_bound_sources(_sources) or _sources.resident_locations_owner() != self or _work.jobs() != _jobs:\n\t\treturn &"ROUTE_OWNER_MISMATCH"\n\treturn &"" if _attest_binding(_bindings, _locations, _owner, _cold) else &"ROUTE_OWNER_MISMATCH"\n\n\nfunc begin_prepare(cold_token: int, space_token: int = 0, location_token: int = 0) -> Result:\n\t"""Copy only within this World\'s already admitted shared operation; graph banks are preallocated."""\n\tif _reject_callback() or _token != 0 or _searching:\n\t\treturn Result.new(&"ROUTE_TRANSACTION_BUSY")\n\tvar code: StringName = _binding_refusal()\n\tif code != &"":\n\t\treturn Result.new(code)\n\tif not _cold.covers(cold_token, 1) or _next_token >= I64_MAX or _live.revision >= I64_MAX:\n\t\treturn Result.new(&"ROUTE_COLD_LEASE")\n\tvar base_revision: int = _owner._header[17]\n\tcode = _preparation_sources_refusal(space_token, location_token)\n\tif code != &"":\n\t\treturn Result.new(code)\n\tif not _cold.covers(cold_token, 1) or _owner._header[17] != base_revision or _token != 0:\n\t\treturn Result.new(&"ROUTE_COLD_LEASE")\n\t_stage.copy_from(_live)\n\t_token = _next_token\n\t_next_token += 1\n\t_cold_token = cold_token\n\t_space_token = space_token\n\t_location_token = location_token\n\t_base_geometry_revision = base_revision\n\t_target_geometry_revision = _owner._s_header[17] if space_token != 0 else base_revision\n\t_operation_error = &""\n\t_remaining = _domain._checks\n\t_sealed = false\n\treturn Result.new(&"", _token)\n\n\nfunc _preparation_sources_refusal(space_token: int, location_token: int) -> StringName:\n\t"""Keep source observers inside the route reentry guard, then close exact candidate pins without callbacks."""\n\t_in_callback = true\n\t_callback_reentered = false\n\tvar code: StringName = _owner.prepared_refusal(space_token) if space_token != 0 else &""\n\tif code == &"" and location_token != 0:\n\t\tcode = _locations.prepared_refusal(location_token)\n\t_in_callback = false\n\tif _callback_reentered:\n\t\treturn &"ROUTE_CALLBACK_REENTRY"\n\tif code != &"":\n\t\treturn code\n\tif _owner._stage_token != space_token or (space_token != 0 and not _owner._sealed):\n\t\treturn &"ROUTE_SPACE_TRANSACTION"\n\tif location_token != 0 and (_locations._token != location_token or not _locations._sealed):\n\t\treturn &"ROUTE_LOCATION_TRANSACTION"\n\treturn &""\n\n\nfunc _reject_callback() -> bool:\n\t"""A validation callback may inspect but cannot mutate or recursively prepare this route owner."""\n\tif _in_callback:\n\t\t_callback_reentered = true\n\t\treturn true\n\treturn false\n\n\nfunc _editable(token: int) -> StringName:\n\t"""All staged mutations share one exact receiver/token, and a failed candidate must be discarded."""\n\tif _reject_callback():\n\t\treturn &"ROUTE_CALLBACK_REENTRY"\n\tif token <= 0 or token != _token or _sealed or not _cold.covers(_cold_token, 1):\n\t\treturn &"ROUTE_TRANSACTION_STALE"\n\treturn _operation_error\n\n\nfunc _location_into(ref: Vector2i, out: Locations.Record) -> StringName:\n\t"""Read sealed fixed metadata inside full candidate proofs; public live reads retain their original contract."""\n\tif _location_token == 0:\n\t\treturn _locations.read_location_into(ref, out)\n\tif not _spend(Locations.PREPARED_OBSERVATION_CHECKS):\n\t\treturn _operation_error\n\treturn Locations.prepared_route_location_into(_locations, self, ref, out)\n\n\nfunc _edge_format_refusal(edge: Edge) -> StringName:\n\t"""Check every integer and complete authored polyline before it reaches a packed column."""\n\tif edge == null or edge.point_count < 2 or edge.point_count > _vertex_capacity \\\n\t\t\tor edge.points.size() < edge.point_count * 3 or edge.from_location == edge.to_location:\n\t\treturn &"ROUTE_EDGE_FORMAT"\n\tif not Space.valid_ref(edge.from_location) or not Space.valid_ref(edge.to_location) \\\n\t\t\tor not Space.valid_ref(edge.section):\n\t\treturn &"ROUTE_EDGE_IDENTITY"\n\tif edge.family < -1 or edge.family >= 5 or edge.variant < 0 or edge.variant > I32_MAX \\\n\t\t\tor edge.rotation < 0 or edge.rotation > 3 or edge.mode < Profiles.MODE_WALK \\\n\t\t\tor edge.mode > Profiles.MODE_CLIMB or edge.mode == Profiles.MODE_WORK \\\n\t\t\tor edge.posture < Profiles.POSTURE_UPRIGHT or edge.posture > Profiles.POSTURE_STOOPED:\n\t\treturn &"ROUTE_EDGE_FORMAT"\n\tif edge.content_revision != _profiles.content_revision() or edge.content_revision < 1 \\\n\t\t\tor edge.geometry_revision != _target_geometry_revision:\n\t\treturn &"ROUTE_EDGE_REVISION"\n\tvar code: StringName = _location_into(edge.from_location, _first)\n\tif code == &"":\n\t\tcode = _location_into(edge.to_location, _second)\n\tif code != &"":\n\t\treturn code\n\tif _first.world != _world or _second.world != _world:\n\t\treturn &"ROUTE_EDGE_DOMAIN"\n\tif _edge_point(edge, 0) != _first.point or _edge_point(edge, edge.point_count - 1) != _second.point:\n\t\treturn &"ROUTE_EDGE_ENDPOINT"\n\tcode = _edge_section_refusal(edge)\n\treturn _edge_length_refusal(edge) if code == &"" else code\n\n\nstatic func _edge_point(edge: Edge, ordinal: int) -> Vector3i:\n\t"""Read one XYZ triple from an already bounded caller packet."""\n\tvar index: int = ordinal * 3\n\treturn Vector3i(edge.points[index], edge.points[index + 1], edge.points[index + 2])\n\n\nfunc _edge_length_refusal(edge: Edge) -> StringName:\n\t"""Length is the sum of ceil integer Euclidean segment lengths; no float chooses a route."""\n\tvar length: int = 0\n\tfor index: int in edge.point_count:\n\t\tvar point: Vector3i = _edge_point(edge, index)\n\t\tfor axis: int in 3:\n\t\t\tif point[axis] < _domain._bounds[axis] or point[axis] >= _domain._bounds[axis + 3]:\n\t\t\t\treturn &"ROUTE_EDGE_BOUNDS"\n\t\tif index == 0:\n\t\t\tcontinue\n\t\tvar distance: int = _segment_length(_edge_point(edge, index - 1), point)\n\t\tif distance < 1 or length > I64_MAX - distance:\n\t\t\treturn &"ROUTE_EDGE_LENGTH"\n\t\tlength += distance\n\treturn &"" if length == edge.length_u else &"ROUTE_EDGE_LENGTH"\n\n\nstatic func _segment_length(first: Vector3i, second: Vector3i) -> int:\n\t"""Exact ceil length; a single-axis segment avoids square-root work on ordinary straight spans."""\n\tvar square: int = 0\n\tvar nonzero: int = 0\n\tvar largest: int = 0\n\tfor axis: int in 3:\n\t\tvar delta: int = absi(int(second[axis]) - int(first[axis]))\n\t\tif delta > 1753413056: # floor(sqrt(INT64_MAX/3)); also bounds interpolation products.\n\t\t\treturn -1\n\t\tsquare += delta * delta\n\t\tnonzero += 1 if delta != 0 else 0\n\t\tlargest = maxi(largest, delta)\n\treturn largest if nonzero < 2 else _ceil_root(square)\n\n\nstatic func _ceil_root(square: int) -> int:\n\t"""Newton descent from an integer power-of-two upper bound returns the exact outward root."""\n\tvar bits: int = 0\n\tvar remaining: int = square\n\tvar shift: int = 32\n\twhile shift > 0:\n\t\tif remaining >> shift != 0:\n\t\t\tremaining >>= shift\n\t\t\tbits += shift\n\t\tshift >>= 1\n\t@warning_ignore("integer_division") var root: int = 1 << ((bits + 2) / 2)\n\twhile true:\n\t\t@warning_ignore("integer_division") var next: int = (root + square / root) / 2\n\t\tif next >= root:\n\t\t\treturn root if root * root == square else root + 1\n\t\troot = next\n\treturn -1 # Unreachable: positive integer descent reaches the floor root.\n\n\nfunc stage_add(token: int, edge: Edge) -> Result:\n\t"""Stage a complete exact authored path; callback refusal poisons only the invisible candidate."""\n\tvar code: StringName = _editable(token)\n\tif code == &"" and (edge == null or edge.point_count < 2 or edge.point_count > _vertex_capacity):\n\t\tcode = &"ROUTE_EDGE_FORMAT"\n\tif code == &"" and not _spend(1 + edge.point_count * 34):\n\t\tcode = &"ROUTE_OPERATION_BUDGET"\n\tif code == &"":\n\t\tcode = _edge_format_refusal(edge)\n\tif code != &"":\n\t\treturn Result.new(code)\n\tif _stage.free_count == 0 or edge.point_count > _vertex_capacity - _stage.vertex_count:\n\t\treturn Result.new(&"ROUTE_ARENA_CAPACITY")\n\tvar row: int = _pop_free(_stage.free_rows, _stage.free_count)\n\t_stage.free_count -= 1\n\t_write_edge(row, edge)\n\t_read_edge(_stage, row, _edge)\n\tcode = _attest_edge(_edge)\n\tif code == &"" and not _edge_packet_matches(_stage, row, _edge):\n\t\tcode = &"ROUTE_CALLBACK_CHANGED_PACKET"\n\tif code != &"":\n\t\t_operation_error = code\n\t\treturn Result.new(code)\n\treturn Result.new(&"", token, Vector2i(row, _edge_i32(_stage, E_GENERATION, row)))\n\n\nfunc _write_edge(row: int, edge: Edge) -> void:\n\t"""Every source field is copied before callback attestation; no caller array remains authoritative."""\n\t_set_edge_i32(_stage, E_GENERATION, row, _edge_i32(_stage, E_GENERATION, row) + 1)\n\t_set_edge_i32(_stage, E_FROM_SLOT, row, edge.from_location.x)\n\t_set_edge_i32(_stage, E_FROM_GENERATION, row, edge.from_location.y)\n\t_set_edge_i32(_stage, E_TO_SLOT, row, edge.to_location.x)\n\t_set_edge_i32(_stage, E_TO_GENERATION, row, edge.to_location.y)\n\t_set_edge_i32(_stage, E_SECTION_SLOT, row, edge.section.x)\n\t_set_edge_i32(_stage, E_SECTION_GENERATION, row, edge.section.y)\n\t_set_edge_i32(_stage, E_FAMILY, row, edge.family)\n\t_set_edge_i32(_stage, E_VARIANT, row, edge.variant)\n\t_set_edge_i32(_stage, E_ROTATION, row, edge.rotation)\n\t_set_edge_i32(_stage, E_PATH_START, row, _stage.vertex_count)\n\t_set_edge_i32(_stage, E_PATH_COUNT, row, edge.point_count)\n\t_set_edge_i32(_stage, E_MODE, row, edge.mode)\n\t_set_edge_i32(_stage, E_POSTURE, row, edge.posture)\n\t_stage.longs[E_CONTENT_REVISION * _edge_capacity + row] = edge.content_revision\n\t_stage.longs[E_GEOMETRY_REVISION * _edge_capacity + row] = edge.geometry_revision\n\t_stage.longs[E_LENGTH * _edge_capacity + row] = edge.length_u\n\tfor index: int in edge.point_count * 3:\n\t\t_stage.vertices[_stage.vertex_count * 3 + index] = edge.points[index]\n\t_stage.vertex_count += edge.point_count\n\t_stage.present[row] = 1\n\t_stage.edge_count += 1\n\n\nfunc _read_edge_metadata(bank: EdgeBank, row: int, out: Edge) -> void:\n\t"""Copy fixed metadata only; callers never borrow authoritative packed bank storage."""\n\tout.ref = Vector2i(row, _edge_i32(bank, E_GENERATION, row))\n\tout.from_location = _edge_pair(bank, E_FROM_SLOT, row)\n\tout.to_location = _edge_pair(bank, E_TO_SLOT, row)\n\tout.section = _edge_pair(bank, E_SECTION_SLOT, row)\n\tout.room = _section.owner if _ids.get_kind(_section.owner) == Directory.KIND_ROOM else NULL_REF\n\tout.level = _section.level\n\tout.family = _edge_i32(bank, E_FAMILY, row)\n\tout.variant = _edge_i32(bank, E_VARIANT, row)\n\tout.rotation = _edge_i32(bank, E_ROTATION, row)\n\tout.mode = _edge_i32(bank, E_MODE, row)\n\tout.posture = _edge_i32(bank, E_POSTURE, row)\n\tout.point_count = _edge_i32(bank, E_PATH_COUNT, row)\n\tout.content_revision = _edge_i64(bank, E_CONTENT_REVISION, row)\n\tout.geometry_revision = _edge_i64(bank, E_GEOMETRY_REVISION, row)\n\tout.length_u = _edge_i64(bank, E_LENGTH, row)\n\n\nfunc _read_edge(bank: EdgeBank, row: int, out: Edge) -> void:\n\t"""Copy the complete polyline only for bounded cold graph operations or explicit caller reads."""\n\t_read_edge_metadata(bank, row, out)\n\tvar start: int = _edge_i32(bank, E_PATH_START, row) * 3\n\tfor index: int in out.point_count * 3:\n\t\tout.points[index] = bank.vertices[start + index]\n\n\nfunc _edge_packet_matches(bank: EdgeBank, row: int, edge: Edge) -> bool:\n\t"""A trusted callback is read-only; even a mutation to another valid packet must refuse."""\n\tif edge.ref != Vector2i(row, _edge_i32(bank, E_GENERATION, row)) \\\n\t\t\tor edge.from_location != _edge_pair(bank, E_FROM_SLOT, row) or edge.to_location != _edge_pair(bank, E_TO_SLOT, row) \\\n\t\t\tor edge.section != _edge_pair(bank, E_SECTION_SLOT, row) or edge.family != _edge_i32(bank, E_FAMILY, row) \\\n\t\t\tor edge.variant != _edge_i32(bank, E_VARIANT, row) or edge.rotation != _edge_i32(bank, E_ROTATION, row) \\\n\t\t\tor edge.mode != _edge_i32(bank, E_MODE, row) or edge.posture != _edge_i32(bank, E_POSTURE, row) \\\n\t\t\tor edge.content_revision != _edge_i64(bank, E_CONTENT_REVISION, row) \\\n\t\t\tor edge.geometry_revision != _edge_i64(bank, E_GEOMETRY_REVISION, row) \\\n\t\t\tor edge.length_u != _edge_i64(bank, E_LENGTH, row) or edge.point_count != _edge_i32(bank, E_PATH_COUNT, row) \\\n\t\t\tor edge.points.size() < edge.point_count * 3:\n\t\treturn false\n\tvar start: int = _edge_i32(bank, E_PATH_START, row) * 3\n\tfor index: int in edge.point_count * 3:\n\t\tif edge.points[index] != bank.vertices[start + index]:\n\t\t\treturn false\n\treturn true\n\n\nfunc _attest_edge(edge: Edge) -> StringName:\n\t"""The real World provider proves complete geometry/profile content and may not mutate route state."""\n\t_in_callback = true\n\t_callback_reentered = false\n\tvar room: Vector2i = edge.room\n\tvar level: int = edge.level\n\tvar code: StringName = _bindings.edge_refusal(edge, _token, _space_token, _location_token)\n\t_in_callback = false\n\tif edge.room != room or edge.level != level:\n\t\treturn &"ROUTE_CALLBACK_CHANGED_PACKET"\n\treturn &"ROUTE_CALLBACK_REENTRY" if _callback_reentered else code\n\n\nfunc edge_into(ref: Vector2i, out: Edge) -> StringName:\n\t"""Read exact live metadata/polyline into sufficient caller scratch, preserving output on refusal."""\n\tif not is_live_edge(ref):\n\t\treturn &"ROUTE_EDGE_STALE"\n\tif out == null or out.points.size() < _edge_i32(_live, E_PATH_COUNT, ref.x) * 3:\n\t\treturn &"ROUTE_OUTPUT_SHAPE"\n\tvar code: StringName = _owner.region_into_reused(_edge_pair(_live, E_SECTION_SLOT, ref.x), _section)\n\tif code != &"" or _section.role != Space.FLOOR_DATUM:\n\t\treturn &"ROUTE_SECTION_STALE"\n\t_read_edge(_live, ref.x, out)\n\treturn &""\n\n\nfunc edge_metadata_into(ref: Vector2i, out: Edge) -> StringName:\n\t"""Read a fixed live span observation without touching its caller\'s polyline array."""\n\tif not is_live_edge(ref):\n\t\treturn &"ROUTE_EDGE_STALE"\n\tif out == null:\n\t\treturn &"ROUTE_OUTPUT_SHAPE"\n\tvar code: StringName = _owner.region_into_reused(_edge_pair(_live, E_SECTION_SLOT, ref.x), _section)\n\tif code != &"" or _section.role != Space.FLOOR_DATUM:\n\t\treturn &"ROUTE_SECTION_STALE"\n\t_read_edge_metadata(_live, ref.x, out)\n\treturn &""\n\n\nstatic func _pop_free(rows: PackedInt32Array, count: int) -> int:\n\t"""Deterministic minimum free slot with no temporary collections."""\n\tvar result: int = rows[0]\n\tcount -= 1\n\tif count > 0:\n\t\trows[0] = rows[count]\n\t\tvar parent: int = 0\n\t\twhile parent * 2 + 1 < count:\n\t\t\tvar child: int = parent * 2 + 1\n\t\t\tif child + 1 < count and rows[child + 1] < rows[child]:\n\t\t\t\tchild += 1\n\t\t\tif rows[parent] <= rows[child]:\n\t\t\t\tbreak\n\t\t\tvar old: int = rows[parent]\n\t\t\trows[parent] = rows[child]\n\t\t\trows[child] = old\n\t\t\tparent = child\n\trows[count] = -1\n\treturn result\n\n\nstatic func _push_free(rows: PackedInt32Array, count: int, row: int) -> void:\n\t"""Return one exact unused row to a preallocated minimum heap."""\n\trows[count] = row\n\twhile count > 0:\n\t\t@warning_ignore("integer_division") var parent: int = (count - 1) / 2\n\t\tif rows[parent] <= rows[count]:\n\t\t\tbreak\n\t\tvar old: int = rows[parent]\n\t\trows[parent] = rows[count]\n\t\trows[count] = old\n\t\tcount = parent\n\n\nfunc _attest_binding(bindings: Bindings, locations: Locations, owner: Owner, cold: Budget) -> bool:\n\t"