+			or actual._sources._construction._buildings != actual._buildings \
+			or not _observation_domain_matches(actual._domain, actual._owner._domain) or actual._domain._world != actual._world:
+		return &"LOCATION_OWNER_MISMATCH"
+	if 256 + 4 * actual._owner._source_capacity > actual._domain._checks:
+		return &"LOCATION_OPERATION_BUDGET"
+	if actual._token != 0 or actual._in_retention or actual._owner._stage_token != 0 or actual._owner._room_callback \
+			or actual._owner._validation_sources >= 0 or actual._owner._validation_regions >= 0:
+		return &"LOCATION_SELECTOR_BUSY"
+	var bank: Bank = actual._live
+	if bank == null or bank == actual._stage or bank.header.size() != HEADER_FIELDS \
+			or bank.i32.size() != I32_FIELDS * actual._capacity or bank.i64.size() != I64_FIELDS * actual._capacity \
+			or bank.present.size() != actual._capacity or bank.header[0] != SCHEMA or bank.header[1] != actual._capacity \
+			or bank.header[2] != actual._world.x or bank.header[3] != actual._world.y or bank.header[13] <= 0:
+		return &"LOCATION_FORMAT"
+	var code: StringName = _route_observation_world_refusal(actual)
+	if code != &"": return code
