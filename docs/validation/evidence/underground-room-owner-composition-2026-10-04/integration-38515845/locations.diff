+static func frontier_scope_refusal(actual: RefCounted, context: FrontierContext, sealed: bool = true) -> StringName:
+	"""Only this exact original receiver, banks, token and still-live Space can expose a prospective row."""
+	if actual == null or context == null or context.get_script() != FrontierContext or actual._frontier != context \
+			or context.count < 1 or context.count > 3 or context.refs.size() != 6 or context.edges.size() != 12 \
+			or context.locations != actual or context.owner != actual._owner or context.budget != actual._cold \
+			or context.live != actual._live or context.candidate != actual._stage or context.world != actual._world \
+			or context.location_token <= 0 or context.location_token != actual._token \
+			or actual._owner_token != 0 or actual._cold_token != context.cold or actual._remaining < 0 \
+			or (sealed and not actual._sealed) or actual._in_retention or actual._retention_reentered \
+			or context.owner._stage_token != 0 or context.owner._header[17] != context.revision \
+			or actual._base_geometry_revision != context.revision or actual._target_geometry_revision != context.revision \
+			or context.budget == null or context.budget._token != context.cold or context.budget._used < Budget.COLD_BYTES:
+		return &"LOCATION_FRONTIER_CONTEXT"
+	if actual._room_admission or actual._world_preparation or actual._installation_active() or actual._phase_active() \
+			or not _route_observation_shape_matches(actual) or actual._live.header.size() != HEADER_FIELDS \
+			or actual._stage.retired.size() != actual._capacity or actual._live.present.size() != actual._capacity \
+			or actual._live.retired.size() != actual._capacity or actual._live.i32.size() != I32_FIELDS * actual._capacity \
+			or actual._live.i64.size() != I64_FIELDS * actual._capacity:
+		return &"LOCATION_FRONTIER_CONTEXT"
+	return &""
