#!/usr/bin/env python3
"""Clean isolated official singleton evidence, with exact restored test-only registry metadata."""
import argparse
import difflib
import hashlib
import json
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parents[4]
EVIDENCE = Path(__file__).resolve().parent
FILES = ['godot/scripts/core/underground_motion_clock.gd', 'godot/test/test_underground_motion_clock.gd']
INPUTS = ['godot/data/underground/mole-worker/evidence/contact-qualification/motion-catalog-v1/candidate-2/motion.ugmotion',
          'godot/data/underground/mole-worker/profile-publication-v2/mole-worker.ugprof',
          'godot/data/underground/initial_level_pack.uglvl', 'tools/run_tests.sh', 'tools/ci_test_shards.py',
          'tools/gdscript_warnings.py', 'tools/underground_motion_memory.py', 'tools/underground_memory_budget.py',
          'tools/audit_registry_capacities.py', 'docs/validation/state_registry_coverage.py']
APPENDIX = '''
### `godot/scripts/core/underground_motion_clock.gd`

| Column group | Members | Width B | Count | Null / unused | Cat | ARCH-SAVE-002 | Notes |
|---|---|---:|---|---|:-:|---|---|
| Stateless source tick sampler | -- | -- | -- | -- | 3 | -- | ADR1147 temporary test-only metadata, expressly authorized by root. Zero retained numeric state or packed fields. Caller44B stays within Motion176B; extra helper ceiling256B shares Motion's existing4096B (counted1090B before this helper). No per-resident clock, source bank or travel permission. Permanent registry remains root-owned. |
'''


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def write(path, value):
    path.write_text(json.dumps(value, indent=2) + '\n')


def snapshot():
    paths = {p for folder in ('scripts', 'demo', 'test', 'data')
             for p in (ROOT / 'godot' / folder).rglob('*.gd') if p.is_file()}
    paths.update(ROOT / name for name in INPUTS)
    paths.update(EVIDENCE / name for name in ('reproduce.py', 'census.py', 'test_census.py'))
    return {str(p.relative_to(ROOT)): sha(p) for p in sorted(paths)}


def validate_import(text):
    pattern = r'^\s*(?:USER )?(?:SCRIPT ERROR|ERROR|WARNING):|(?:Parse|Parser) Error:|resources still in use at exit|ObjectDB instances? (?:were |was )?leaked'
    findings = re.findall(pattern, text, re.M)
    if findings:
        raise RuntimeError('Import contains raw errors, warnings or leaked resources')
    return findings


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--out', type=Path, required=True)
    parser.add_argument('--port', type=int, default=6317)
    args = parser.parse_args()
    if args.out.is_symlink() or args.out.exists():
        raise ValueError('Evidence output must be new and not a symlink')
    out = args.out.resolve()
    out.mkdir(parents=True, exist_ok=False)
    project = ROOT / 'godot/project.godot'
    registry = ROOT / 'docs/persistence_state_registry.md'
    original_project, original_registry = project.read_bytes(), registry.read_bytes()
    if b'config/use_custom_user_dir' in original_project or original_project.count(b'[application]\n') != 1:
        raise ValueError('Refuse incompatible existing project user-directory configuration')
    if b'### `godot/scripts/core/underground_motion_clock.gd`' in original_registry:
        raise ValueError('This historical reproducer expects the documented unregistered new clock')
    isolated = 'Redwall-ug1147-' + hashlib.sha256(str(out).encode()).hexdigest()[:16]
    test_project = original_project.replace(b'[application]\n', (
        '[application]\nconfig/use_custom_user_dir=true\nconfig/custom_user_dir_name="' + isolated + '"\n').encode(), 1)
    test_registry = original_registry + APPENDIX.encode()
    (out / 'registry-test-only-append.md').write_text(APPENDIX)
    (out / 'registry-test-only.diff').write_text(''.join(difflib.unified_diff(
        original_registry.decode().splitlines(True), test_registry.decode().splitlines(True),
        fromfile='original/persistence_state_registry.md', tofile='test-only/persistence_state_registry.md')))
    pins = snapshot()
    write(out / 'inputs-before.json', pins)
    write(out / 'source-sha256.json', {name: sha(ROOT / name) for name in FILES})
    head = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()
    assets = ROOT / 'godot/demo/assets'
    if assets.is_symlink():
        raise ValueError('Refuse shared/symlink assets before isolation')
    record = {'head_before': head, 'commands': [], 'custom_user_dir_name': isolated,
              'project_sha256_before': sha(project), 'registry_sha256_before': sha(registry),
              'assets_present_before': assets.exists(), 'runtime_qualified': False}
    status = 1

    def run(command, log_name):
        started = time.monotonic()
        with (out / log_name).open('w') as log:
            result = subprocess.run(command, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, timeout=900)
        record['commands'].append({'command': command, 'exit_code': result.returncode,
                                   'seconds': round(time.monotonic() - started, 3), 'log': log_name})
        print(log_name, result.returncode, flush=True)
        if result.returncode:
            raise RuntimeError(log_name + ' failed')

    with tempfile.TemporaryDirectory(prefix='ug1147-assets-', dir=ROOT) as temporary:
        parked = Path(temporary) / 'assets'
        try:
            project.write_bytes(test_project)
            registry.write_bytes(test_registry)
            if assets.exists():
                assets.rename(parked)
            shutil.rmtree(ROOT / 'godot/.godot', ignore_errors=True)
            run(['godot', '--headless', '--path', 'godot', '--editor', '--quit'], 'clean-import.log')
            record['import_raw_findings'] = validate_import((out / 'clean-import.log').read_text())
            sys.path.insert(0, str(ROOT / 'tools'))
            import ci_test_shards as shards
            plan = shards.make_plan(len(shards.discover(ROOT)), repo=ROOT,
                                    weights_path=ROOT / 'tools/ci_test_shard_weights.json')
            suite = 'test_underground_motion_clock.gd'
            index = next(i for i, group in enumerate(plan['shards']) if group == [suite])
            run(['./tools/run_tests.sh', '--shard', f"{index}/{plan['shard_count']}",
                 '--output-dir', str(out)], 'strict.log')
            counts, actual, _ = shards.parse_log((out / 'strict.log').read_text())
            if actual != [suite]:
                raise RuntimeError('Official singleton suite census mismatch')
            record['strict_counts'] = counts
            run(['python3', '-B', str(EVIDENCE / 'test_census.py')], 'census-tests.log')
            run(['python3', '-B', str(EVIDENCE / 'census.py')], 'census.json')
            run(['python3', 'tools/gdscript_warnings.py', '--max', '0', '--port', str(args.port),
                 '--json', str(out / 'analyzer.json'), *FILES], 'analyzer.log')
            status = 0
        except (Exception, KeyboardInterrupt) as error:
            record['error'] = repr(error)
        finally:
            project.write_bytes(original_project)
            registry.write_bytes(original_registry)
            if parked.exists():
                parked.rename(assets)
            after = snapshot()
            write(out / 'inputs-after.json', after)
            record.update(project_restored=project.read_bytes() == original_project,
                          registry_restored=registry.read_bytes() == original_registry,
                          assets_restored=assets.exists() == record['assets_present_before'],
                          source_unchanged=after == pins,
                          head_unchanged=subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip() == head)
            if not all(record[key] for key in ('project_restored', 'registry_restored', 'assets_restored', 'source_unchanged', 'head_unchanged')):
                status = 1
            record['exit_code'] = status
            write(out / 'invocation.json', record)
    return status


if __name__ == '__main__':
    raise SystemExit(main())
