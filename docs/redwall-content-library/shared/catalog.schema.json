{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Redwall research catalog",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "redwall_research_catalog_v1"
    },
    "activation": {
      "const": "NOT_RUNTIME_ACTIVE"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "book_key": {
            "enum": [
              "redwall",
              "mossflower",
              "salamandastron",
              "martin_warrior",
              "outcast",
              "pearls_lutra",
              "long_patrol",
              "marlfox",
              "lord_brocktree",
              "taggerung",
              "triss",
              "rakkety_tam"
            ]
          },
          "local_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "CHARACTER",
              "FACTION",
              "PLACE",
              "FOOD",
              "INGREDIENT",
              "OBJECT",
              "CULTURE",
              "ECOLOGY",
              "SYSTEM",
              "THEME"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "record_scope": {
            "enum": [
              "INDIVIDUAL_REFERENCE",
              "CHUNK_DOSSIER"
            ]
          },
          "facts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_type": {
                  "enum": [
                    "NARRATOR",
                    "CHARACTER_REPORT",
                    "BELIEF",
                    "AMBIGUOUS",
                    "INFERRED_GAME"
                  ]
                },
                "locator": {
                  "type": "object",
                  "properties": {
                    "block_start": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "block_end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "source_start": {
                      "type": "object",
                      "properties": {
                        "unit": {
                          "type": "string",
                          "minLength": 1
                        },
                        "unit_block": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "unit",
                        "unit_block"
                      ],
                      "additionalProperties": false
                    },
                    "source_end": {
                      "type": "object",
                      "properties": {
                        "unit": {
                          "type": "string",
                          "minLength": 1
                        },
                        "unit_block": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "unit",
                        "unit_block"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "block_start",
                    "block_end",
                    "source_start",
                    "source_end"
                  ],
                  "additionalProperties": false
                },
                "raw_fact_index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "text",
                "evidence_type",
                "locator",
                "raw_fact_index"
              ],
              "additionalProperties": false
            }
          },
          "game_use": {
            "type": "string"
          },
          "adaptation_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "raw_record_path": {
            "type": "string",
            "minLength": 1
          },
          "runtime_activation": {
            "const": "NOT_RUNTIME_ACTIVE"
          }
        },
        "required": [
          "id",
          "book_key",
          "local_id",
          "kind",
          "label",
          "aliases",
          "record_scope",
          "facts",
          "game_use",
          "adaptation_notes",
          "raw_record_path",
          "runtime_activation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "activation",
    "records"
  ],
  "additionalProperties": false
}
