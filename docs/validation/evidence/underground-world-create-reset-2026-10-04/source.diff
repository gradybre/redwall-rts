+class PartialClearHost extends SettlementScript:
+	var stop_during_clear: bool = false
+	var captured_request: WorldInitScript.Request = null
+	var captured_scope: RefCounted = null
+
+	func _clear_stores() -> void:
+		"""Negative fixture interrupts the real clear; it never overrides a successful owner proof."""
+		if not stop_during_clear:
+			super._clear_stores()
+			return
+		captured_request = world()._prepared_request
+		captured_scope = _underground_session._retirement_scope
+		residents().clear()
+
+
+func _create_on_reset_host(reset_into: Callable) -> bool:
+	"""Use the actual host's existing World and all nine original stores through the composed form."""
+	return _session.create_with_cohort_into(_reset_host.directory(),
+		_reset_host.ecology().resource_nodes(), _reset_host.ecology().forage(),
+		_reset_host.ecology().fishing(), _reset_host.rng(), _reset_host.crop_weather().farming(),
+		_reset_host.ecology().orchard_hive(), _reset_host.jobs(), _reset_host.commands(),
+		_report, reset_into, _create_host_cohort, _reset_host.world())
+
+
+func _create_host_cohort(world: WorldInitScript) -> bool:
+	"""Count whether the gate was crossed, then perform the real placed cohort operation."""
+	_cohort_calls += 1
+	return _reset_host.create_placed_cohort_on(world)
+
+
+func _actual_reset_into(out: UiWorldSession.ResetOutcome) -> void:
+	"""Test-owned actual host uses the same public reset/abandon result contract as UIManager."""
+	if _reset_host.reset(true):
+		out.state = UiWorldSession.RESET_CLEARED
+		out.error = &""
+		return
+	_reset_cause = _reset_host.last_refusal()
+	out.error = _reset_cause
+	out.state = UiWorldSession.RESET_RETAINED if _reset_host.abandon_world_reset() else UiWorldSession.RESET_STOPPED
+
+
+func _unwritten_boolean_reset(_out: UiWorldSession.ResetOutcome) -> bool:
+	"""A legacy-looking return value must not grant clearing or erase the staged plan."""
+	_captured_request = _reset_host.world()._prepared_request
+	return true
+
+
+func _malformed_reset(out: UiWorldSession.ResetOutcome) -> void:
+	"""A success enum paired with a failure code is not a complete host observation."""
+	_captured_request = _reset_host.world()._prepared_request
+	out.state = UiWorldSession.RESET_CLEARED
+	out.error = &"TEST_RESET_FAILED"
+
+
+func test_default_reset_outcome_and_invalid_states_never_report_cleared() -> void:
+	"""Incomplete callback output stays stopped; a previous successful report cannot leak through."""
+	var outcome: UiWorldSession.ResetOutcome = UiWorldSession.ResetOutcome.new()
+	assert_equal(outcome.state, UiWorldSession.RESET_STOPPED, "default is stopped")
+	assert_false(_session.record_reset_outcome(_report, outcome), "unwritten refuses")
+	outcome.state = UiWorldSession.RESET_CLEARED
+	outcome.error = &""
+	assert_true(_session.record_reset_outcome(_report, outcome), "complete observation")
+	outcome.state = 3
+	assert_false(_session.record_reset_outcome(_report, outcome), "unknown enum refuses")
+	assert_equal(_report.reset_state, UiWorldSession.RESET_STOPPED, "previous cleared value erased")
+	outcome.state = UiWorldSession.RESET_RETAINED
+	assert_false(_session.record_reset_outcome(_report, outcome), "retained requires original failure")
+	assert_equal(_report.reset_error, UiWorldSession.REFUSE_RESET_OUTCOME, "malformed protocol identified")
+	assert_false(_session.record_reset_outcome(_report, null), "missing packet refuses")
+
+
+func test_boolean_return_cannot_replace_typed_reset_observation() -> void:
+	"""A true return leaves the exact prepared request and all live owners untouched."""
+	_reset_host = SettlementScript.new()
+	var before: PackedByteArray = _reset_host.directory().state_bytes()
+	assert_false(_create_on_reset_host(_unwritten_boolean_reset), "return true is not proof")
+	assert_equal(_cohort_calls, 0, "no cohort callback")
+	assert_equal(_report.reset_state, UiWorldSession.RESET_STOPPED, "truthful stopped state")
+	assert_equal(_report.reset_error, UiWorldSession.REFUSE_RESET_OUTCOME, "missing output identified")
+	assert_not_null(_captured_request, "actual staged request existed")
+	assert_equal(_reset_host.world()._prepared_request, _captured_request, "request not discarded")
+	assert_equal(_reset_host.directory().state_bytes(), before, "no authority writes")
+	assert_false(_reset_host.world().is_published(), "no fake publication")
+
+
+func test_malformed_cleared_result_preserves_original_plan() -> void:
+	"""Contradictory packet fields cannot seed the prepared streams or clear request identity."""
+	_reset_host = SettlementScript.new()
+	assert_false(_create_on_reset_host(_malformed_reset), "contradictory callback refuses")
+	assert_equal(_cohort_calls, 0, "no cohort callback")
+	assert_equal(_report.reset_state, UiWorldSession.RESET_STOPPED, "refusal remains stopped")
+	assert_equal(_reset_host.world()._prepared_request, _captured_request, "same staged request")
+	assert_equal(_session.generated_count(), 0, "no generated count")
+
+
+func test_actual_typed_reset_preserves_cohort_first_publication() -> void:
