+	"""Programme5 consumes the original30Hz source clock; drawing zero or many frames never advances it."""
+	if _source == null or _retired or out == null or out.frames.size() != 7 \
+			or actual == null or actual._profiles != _profiles or _pins.size() != 54 or _pins[6] != 10:
