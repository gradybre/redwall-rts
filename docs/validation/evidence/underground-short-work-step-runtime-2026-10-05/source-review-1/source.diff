+	assert_equal(_routes.request_route(_worker, last, 0), &"ROUTE_SOURCE_STEP_SPAN", "two spans cannot spend the narrow source prefix twice")
+	_binding.synthetic_pace = 3278
+	assert_equal(_routes.request_route(_worker, wrong, 0), &"ROUTE_SOURCE_STEP_PACE", "source root rate is immutable")
+	assert_equal(_short_route_image(), original, "all refused requests preserve original canonical state")
