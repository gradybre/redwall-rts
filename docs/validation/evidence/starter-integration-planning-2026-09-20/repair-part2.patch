+		if row.is_empty():
+			return false
+		var wanted: Array = REQUIRED_FURNITURE_DIMENSIONS[key]
+		if int(row[BuildingDefinitions.F_FLOOR_X]) != int(wanted[0]):
+			return false
+		if int(row[BuildingDefinitions.F_FLOOR_Z]) != int(wanted[1]):
