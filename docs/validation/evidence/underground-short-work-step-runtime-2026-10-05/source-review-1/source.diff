+	var last: Vector2i = _location(a + Vector3i(232, 0, 0))
+	_publish_edges([_edge(first, wrong, [a, a + Vector3i(233, 0, 0)]),
+		_edge(first, middle, [a, a + Vector3i(116, 0, 0)]),
+		_edge(middle, last, [a + Vector3i(116, 0, 0), a + Vector3i(232, 0, 0)])])
+	assert_equal(_routes.admit_travel_actor(_worker, NULL_REF, first, 10, 1, 3, 0, -1), &"", "new finite actor READY")
