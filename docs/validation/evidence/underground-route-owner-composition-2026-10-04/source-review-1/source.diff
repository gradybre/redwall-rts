+			or graph._buildings != o.buildings or graph._cold != o.budget or graph._world != o.world_ref \
+			or graph._domain == null or graph._domain._world != o.world_ref \
+			or graph._location_capacity != Routes.MAX_LOCATIONS or graph._vertex_capacity != Routes.MAX_VERTICES \
+			or graph._link_capacity != Routes.MAX_LINKS or graph._retention == null \
