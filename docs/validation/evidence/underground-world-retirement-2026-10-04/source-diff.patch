+	host = null # A previously freed object is rejected by Godot before a typed API body can run.
+	assert_equal(Retirement.release_preflighted(_scope, host, _session), &"WORLD_RETIREMENT_SCOPE", "absent host refuses")
+	assert_equal(Retirement.release_preflighted(_scope, _host, _session), &"WORLD_RETIREMENT_SCOPE", "expired original host cannot be replaced")
+	_links_retained()
