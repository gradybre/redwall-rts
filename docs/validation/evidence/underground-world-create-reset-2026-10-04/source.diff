+	assert_equal(_cohort_calls, 1, "exactly one actual cohort")
+	assert_equal(_reset_host.population(), 12, "all starter residents")
+	assert_equal(_report.reset_state, UiWorldSession.RESET_CLEARED, "actual clear recorded")
+	assert_equal(_report.reset_error, &"", "no reset failure")
+	assert_equal(_session.world(), _reset_host.world(), "one actual World")
+	assert_true(_reset_host.world().is_published(), "published after cohort")
+	assert_equal(_reset_host.ecology().resource_nodes().count(), 1695, "actual content count")
+
