+func test_short_step_requires_three_root_ticks_and_complete_fades_in_both_directions() -> void:
+	"""Real Routes/Transforms consume the accepted integer law; World/source certificates here remain synthetic."""
+	_clock_profiles(NULL_REF, false, 6)
+	_binding.synthetic_pace = 3277
+	var a: Vector3i = Vector3i(-512, 0, 512)
+	var b: Vector3i = a + Vector3i(232, 0, 0)
+	var first: Vector2i = _location(a)
+	var last: Vector2i = _location(b)
+	_publish_edges([_edge(first, last, [a, b]), _edge(last, first, [b, a])])
+	assert_equal(_routes.admit_travel_actor(_worker, NULL_REF, first, 12, 1, 3, 0, -1), &"", "original canonical ground admission")
+	assert_equal(_routes.refresh_travel_actor(_worker, NULL_REF, 10, 1, 3, 0, -1), &"", "same actual READY switches to finite source")
+	assert_equal(_routes.request_route(_worker, last, 0), &"", "one complete terminal span")
+	_short_replay(a, b, 10, 1)
+	assert_equal(_routes.refresh_travel_actor(_worker, NULL_REF, 11, 1, 3, 0, -1), &"", "only actual READY may reverse source")
+	assert_equal(_routes.request_route(_worker, first, 20), &"", "same complete reverse programme")
+	_short_replay(b, a, 11, 20)
+	assert_equal(_routes.refresh_travel_actor(_worker, NULL_REF, 12, 1, 3, 0, -1), &"", "complete recovery returns to canonical ground")
+	assert_equal(_routes.refresh_actor(_worker, NULL_REF, Profiles.MODE_WALK, 0, -1), &"ROUTE_SOURCE_HANDOFF_REQUIRED", "no silent loss of canonical source into legacy policy0")
+
+
+func _short_replay(first: Vector3i, last: Vector3i, profile: int, first_tick: int) -> void:
+	"""Eight fade ticks, exactly three accepted root ticks, then eight recovery ticks independent of drawing."""
+	var state: PackedInt64Array = PackedInt64Array([0, 0, 0, 0])
+	var actor: Routes.Actor = Routes.Actor.new()
+	for elapsed: int in 19:
+		assert_equal(_routes.advance_tick(first_tick + elapsed), 1, "actual accepted fixed tick")
+		assert_equal(_routes.source_state_into(_worker, NULL_REF, profile, 1, 3, state), &"", "original current canonical tuple")
+		assert_equal(_routes.read_actor_into(_worker, actor), &"", "actual Transform and endpoint identity")
+		var distance: int = 0 if elapsed < 8 else (109 if elapsed == 8 else (218 if elapsed == 9 else 232))
+		assert_equal(actor.point, first + Vector3i(distance if last.x > first.x else -distance, 0, 0), "exact rational root progress")
+		assert_equal(actor.yaw, 49152, "backward root never reverses the body heading")
+		if elapsed < 18:
+			var original: PackedByteArray = _short_route_image()
+			assert_equal(_routes.cancel_route(_worker), &"ROUTE_SOURCE_STEP_ACTIVE", "partial source may only hold/resume")
+			assert_equal(_short_route_image(), original, "cancel refusal is byte-exact")
+	assert_equal(Routes.source_ready_leaf_refusal(_routes, _worker, NULL_REF, profile, 1, 3), &"", "whole programme completes at READY")
+
+
