+# --- ARCH-SAVE-002 section 4 owner 6 column validation (INJURY-S4-VALIDATE-R01 v1, ADR 0177) --
+#
+# ONE PURE PREDICATE over an owner 6 column image. `columns_refusal()` reads no store member,
+# writes none, sets no diagnostic, constructs nothing and allocates no packed scratch. It takes
+# the eleven columns in the canonical owner-local order -- five bytes, three i32, three i64 --
+# and answers REFUSE_NONE or the exact code of the FIRST gate that refuses. Every gate finishes
+# its own complete 512-row scan before the next gate begins; no rule is fused into a single
+# per-row pass, so dropping one clause is observable on its own rather than masked by a neighbour.
+#
+# THE SAVED DOMAINS ARE THE STORE'S. Untreated ticks, care progress and the incident ordinal all
+# admit the full nonnegative signed-int64 range, because existing public writers reach it. There
+# is no recipe work ceiling, no elapsed-time ceiling and no float anywhere in this predicate.
+#
+# RETAINED HISTORY IS LEGAL, NOT AN ERROR. A healthy present row may carry a rescuer, a treated
+# row keeps its incident ordinal and both latches, and a stale rescuer reference survives by
+# design -- current Directory liveness is deliberately unavailable here, and two different
+# generations on one global slot are distinct references that both stay legal.
+#
+# WHAT AN ACCEPTED IMAGE DOES NOT CERTIFY. Saved Needs/resident presence and health agreement,
+# Directory patient and rescuer kind and identity, self-rescue, the movement care context,
+# same-file provenance, bulk capture/restore and derived counts are all INJURY-SAVED-BINDINGS
+# obligations outside this predicate.
+
+const REFUSE_COLUMN_SHAPE: StringName = &"COLUMN_SHAPE"
+const REFUSE_COLUMN_FLAGS: StringName = &"COLUMN_FLAGS"
+const REFUSE_COLUMN_KIND: StringName = &"COLUMN_KIND"
+const REFUSE_COLUMN_SEVERITY: StringName = &"COLUMN_SEVERITY"
+const REFUSE_COLUMN_RESCUER_REF: StringName = &"COLUMN_RESCUER_REF"
+const REFUSE_COLUMN_UNTREATED_TICKS: StringName = &"COLUMN_UNTREATED_TICKS"
+const REFUSE_COLUMN_CARE_PROGRESS: StringName = &"COLUMN_CARE_PROGRESS"
+const REFUSE_COLUMN_INCIDENT_ORDINAL: StringName = &"COLUMN_INCIDENT_ORDINAL"
+const REFUSE_COLUMN_KIND_SEVERITY: StringName = &"COLUMN_KIND_SEVERITY"
+const REFUSE_COLUMN_NO_INJURY: StringName = &"COLUMN_NO_INJURY"
+const REFUSE_COLUMN_INCIDENT_HISTORY: StringName = &"COLUMN_INCIDENT_HISTORY"
+const REFUSE_COLUMN_INACTIVE: StringName = &"COLUMN_INACTIVE"
+const REFUSE_COLUMN_RESCUER_DUPLICATE: StringName = &"COLUMN_RESCUER_DUPLICATE"
+
+
+static func columns_refusal(present: PackedByteArray, kind: PackedByteArray,
+		airless_episode: PackedByteArray, exhaustion_latch: PackedByteArray,
+		care_context_blocked: PackedByteArray, severity: PackedInt32Array,
+		rescuer_slot: PackedInt32Array, rescuer_generation: PackedInt32Array,
+		untreated_ticks: PackedInt64Array, care_progress_mwu: PackedInt64Array,
+		last_incident_ordinal: PackedInt64Array) -> StringName:
+	"""THE single owner 6 predicate over an Injury column image: REFUSE_NONE, or the exact code.
+
+	Argument-only and pure. The total order is the contract's: all eleven shapes before any
+	indexing, then the scalar domains, then the relations between them, then the inactive-row
+	rule, and last the exact nonnull rescuer-pair uniqueness scan.
+	"""
+	if not _columns_are_capacity_sized(present, kind, airless_episode, exhaustion_latch,
+			care_context_blocked, severity, rescuer_slot, rescuer_generation, untreated_ticks,
+			care_progress_mwu, last_incident_ordinal):
+		return REFUSE_COLUMN_SHAPE
+	var domains: StringName = _column_domain_refusal(present, kind, airless_episode,
+		exhaustion_latch, care_context_blocked, severity, rescuer_slot, rescuer_generation,
+		untreated_ticks, care_progress_mwu, last_incident_ordinal)
+	if domains != REFUSE_NONE:
+		return domains
+	var relations: StringName = _column_relation_refusal(kind, airless_episode, exhaustion_latch,
+		severity, untreated_ticks, care_progress_mwu, last_incident_ordinal)
+	if relations != REFUSE_NONE:
+		return relations
+	var inactive: StringName = _column_inactive_refusal(present, kind, airless_episode,
+		exhaustion_latch, care_context_blocked, severity, rescuer_slot, rescuer_generation,
+		untreated_ticks, care_progress_mwu, last_incident_ordinal)
+	if inactive != REFUSE_NONE:
+		return inactive
+	return _column_rescuer_duplicate_refusal(present, rescuer_slot, rescuer_generation)
+
+
+static func _columns_are_capacity_sized(present: PackedByteArray, kind: PackedByteArray,
+		airless_episode: PackedByteArray, exhaustion_latch: PackedByteArray,
+		care_context_blocked: PackedByteArray, severity: PackedInt32Array,
+		rescuer_slot: PackedInt32Array, rescuer_generation: PackedInt32Array,
+		untreated_ticks: PackedInt64Array, care_progress_mwu: PackedInt64Array,
+		last_incident_ordinal: PackedInt64Array) -> bool:
+	"""Gate 1: all eleven columns hold exactly RESIDENT_CAPACITY values, before any indexed read."""
+	if present.size() != RESIDENT_CAPACITY or kind.size() != RESIDENT_CAPACITY:
+		return false
+	if airless_episode.size() != RESIDENT_CAPACITY \
+			or exhaustion_latch.size() != RESIDENT_CAPACITY \
+			or care_context_blocked.size() != RESIDENT_CAPACITY:
+		return false
+	if severity.size() != RESIDENT_CAPACITY or rescuer_slot.size() != RESIDENT_CAPACITY \
+			or rescuer_generation.size() != RESIDENT_CAPACITY:
+		return false
+	return untreated_ticks.size() == RESIDENT_CAPACITY \
+		and care_progress_mwu.size() == RESIDENT_CAPACITY \
+		and last_incident_ordinal.size() == RESIDENT_CAPACITY
+
+
+static func _column_domain_refusal(present: PackedByteArray, kind: PackedByteArray,
+		airless_episode: PackedByteArray, exhaustion_latch: PackedByteArray,
+		care_context_blocked: PackedByteArray, severity: PackedInt32Array,
+		rescuer_slot: PackedInt32Array, rescuer_generation: PackedInt32Array,
+		untreated_ticks: PackedInt64Array, care_progress_mwu: PackedInt64Array,
+		last_incident_ordinal: PackedInt64Array) -> StringName:
+	"""Gates 2-8: the four flag bytes, the kind byte, severity, the ref pair, the three i64 floors."""
+	if not _byte_column_below(present, 2) or not _byte_column_below(airless_episode, 2) \
+			or not _byte_column_below(exhaustion_latch, 2) \
+			or not _byte_column_below(care_context_blocked, 2):
+		return REFUSE_COLUMN_FLAGS
+	if not _byte_column_below(kind, KIND_COUNT):
+		return REFUSE_COLUMN_KIND
+	if not _i32_column_within(severity, SEVERITY_NONE, SEVERITY_SERIOUS):
+		return REFUSE_COLUMN_SEVERITY
+	if not _rescuer_pairs_valid(rescuer_slot, rescuer_generation):
+		return REFUSE_COLUMN_RESCUER_REF
+	if not _i64_column_nonnegative(untreated_ticks):
+		return REFUSE_COLUMN_UNTREATED_TICKS
+	if not _i64_column_nonnegative(care_progress_mwu):
+		return REFUSE_COLUMN_CARE_PROGRESS
+	if not _i64_column_nonnegative(last_incident_ordinal):
+		return REFUSE_COLUMN_INCIDENT_ORDINAL
+	return REFUSE_NONE
+
+
+static func _byte_column_below(column: PackedByteArray, bound: int) -> bool:
+	"""True when every byte of the whole column is in [0, bound). One C++ count per legal value."""
+	var total: int = 0
+	for value: int in bound:
+		total += column.count(value)
+	return total == column.size()
+
+
+static func _i32_column_within(column: PackedInt32Array, low: int, high: int) -> bool:
+	"""True when every signed i32 entry of the whole column lies in [low, high]."""
+	for row: int in column.size():
+		if column[row] < low or column[row] > high:
+			return false
+	return true
+
+
+static func _i64_column_nonnegative(column: PackedInt64Array) -> bool:
+	"""True when every signed i64 entry is nonnegative; the saved domain runs to INT64_MAX."""
+	for row: int in column.size():
+		if column[row] < 0:
+			return false
+	return true
+
+
+static func _rescuer_pairs_valid(rescuer_slot: PackedInt32Array,
+		rescuer_generation: PackedInt32Array) -> bool:
+	"""True when every pair is exactly NULL_REF, or a directory slot with a positive generation.
+
+	The slot is a GLOBAL directory slot in 0..352417, never a patient row index, so it is never
+	compared against this store's own row to infer a self-rescue.
+	"""
+	for row: int in rescuer_slot.size():
+		var slot: int = rescuer_slot[row]
+		var generation: int = rescuer_generation[row]
+		if slot == NULL_SLOT and generation == NULL_GENERATION:
+			continue
+		if slot < 0 or slot >= EntityDirectory.DIRECTORY_CAPACITY or generation <= 0:
+			return false
+	return true
+
+
+static func _column_relation_refusal(kind: PackedByteArray, airless_episode: PackedByteArray,
+		exhaustion_latch: PackedByteArray, severity: PackedInt32Array,
+		untreated_ticks: PackedInt64Array, care_progress_mwu: PackedInt64Array,
+		last_incident_ordinal: PackedInt64Array) -> StringName:
+	"""Gates 9-11: kind/severity equivalence, the no-injury reset, and positive incident history.
+
+	The history gate constrains an active kind AND either episode latch, and deliberately NOT the
+	care-context byte, which an uninjured row may legally carry. A latched row is never forced to
+	a particular current kind: treatment and later incidents both retain those flags.
+	"""
+	for row: int in kind.size():
+		if (kind[row] == KIND_NONE) != (severity[row] == SEVERITY_NONE):
+			return REFUSE_COLUMN_KIND_SEVERITY
+	for row: int in kind.size():
+		if kind[row] != KIND_NONE:
+			continue
+		if untreated_ticks[row] != 0 or care_progress_mwu[row] != 0:
+			return REFUSE_COLUMN_NO_INJURY
+	for row: int in kind.size():
+		if kind[row] == KIND_NONE and airless_episode[row] == 0 and exhaustion_latch[row] == 0:
+			continue
+		if last_incident_ordinal[row] <= 0:
+			return REFUSE_COLUMN_INCIDENT_HISTORY
+	return REFUSE_NONE
+
+
+static func _column_inactive_refusal(present: PackedByteArray, kind: PackedByteArray,
+		airless_episode: PackedByteArray, exhaustion_latch: PackedByteArray,
+		care_context_blocked: PackedByteArray, severity: PackedInt32Array,
+		rescuer_slot: PackedInt32Array, rescuer_generation: PackedInt32Array,
+		untreated_ticks: PackedInt64Array, care_progress_mwu: PackedInt64Array,
+		last_incident_ordinal: PackedInt64Array) -> StringName:
+	"""Gate 12: an inactive row is canonically all zero with exactly the null rescuer pair.
+
+	Stronger than the ResourceNodes analogue, and rightly so: `_write_empty_row()` and `clear()`
+	both zero every column and write NULL_REF, so an inactive Injury row retains no residue.
+	"""
+	var row: int = present.find(0, 0)
+	while row >= 0:
+		if kind[row] != KIND_NONE or airless_episode[row] != 0 or exhaustion_latch[row] != 0 \
+				or care_context_blocked[row] != 0 or severity[row] != SEVERITY_NONE:
+			return REFUSE_COLUMN_INACTIVE
+		if untreated_ticks[row] != 0 or care_progress_mwu[row] != 0 \
+				or last_incident_ordinal[row] != 0:
+			return REFUSE_COLUMN_INACTIVE
+		if rescuer_slot[row] != NULL_SLOT or rescuer_generation[row] != NULL_GENERATION:
+			return REFUSE_COLUMN_INACTIVE
+		row = present.find(0, row + 1)
+	return REFUSE_NONE
+
+
+static func _column_rescuer_duplicate_refusal(present: PackedByteArray,
+		rescuer_slot: PackedInt32Array, rescuer_generation: PackedInt32Array) -> StringName:
+	"""Gate 13: no exact nonnull rescuer pair is shared by two present rows.
+
+	The same bounded nested ascending scan `_rescuer_patient_count()` already uses, over present
+	rows only, allocating nothing: no temporary packed array, no sort and no map. BOTH halves are
+	compared, so two different generations on one global slot remain distinct stale references.
+	"""
+	for row: int in RESIDENT_CAPACITY:
+		if present[row] == 0 or rescuer_slot[row] == NULL_SLOT:
+			continue
+		for other: int in range(row + 1, RESIDENT_CAPACITY):
+			if present[other] == 0:
+				continue
+			if rescuer_slot[other] == rescuer_slot[row] \
+					and rescuer_generation[other] == rescuer_generation[row]:
+				return REFUSE_COLUMN_RESCUER_DUPLICATE
+	return REFUSE_NONE
