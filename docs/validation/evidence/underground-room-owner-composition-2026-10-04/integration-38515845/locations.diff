+static func frontier_rows_refusal(actual: RefCounted, context: FrontierContext, records: Array[Record],
+		heap_patch: PackedInt32Array) -> StringName:
+	"""Expected Records remain private to the coordinator; no observer can rewrite both candidate and expected payload."""
+	var code: StringName = frontier_scope_refusal(actual, context)
+	if code != &"": return code
+	if records.size() != 3 or actual._stage.header[13] != actual._live.header[13] + 1 \
+			or actual._stage.count != actual._live.count + context.count \
+			or actual._stage.free_count != actual._live.free_count - context.count: return &"LOCATION_FRONTIER_ROWS"
+	for index: int in context.count:
+		var ref: Vector2i = Vector2i(context.refs[2 * index], context.refs[2 * index + 1])
+		if not frontier_record_matches(actual, context, ref, records[index]): return &"LOCATION_FRONTIER_ROWS"
+		for before: int in index:
+			if context.refs[2 * before] == ref.x: return &"LOCATION_FRONTIER_ROWS"
+	for field: int in HEADER_FIELDS:
+		if field != 13 and actual._stage.header[field] != actual._live.header[field]: return &"LOCATION_FRONTIER_ROWS"
+	code = _frontier_order_refusal(actual)
+	if code == &"": code = frontier_heap_refusal(actual._live.free_rows, actual._stage.free_rows,
+		actual._live.free_count, context.refs, context.count, heap_patch, false)
+	return _frontier_unchanged_rows(actual, context) if code == &"" else code
