+static func columns_refusal(columns: Columns) -> StringName:
+	"""THE pure §4 residents column predicate (ADR0178). REFUSE_NONE when admissible.
+
+	Argument-only: it constructs no store, mutates nothing, and reads no catalog, Directory or
+	Needs row, so a framed bridge can validate a captured image with no live owner. It is the
+	shared local prefix followed by the two per-present-row scalar rules in that order, species
+	then arrival. Verified species-to-size agreement, saved Directory identity and every other
+	cross-owner binding stay with the live restore and with RESIDENTS-SAVED-BINDINGS, not here.
+	"""
+	var prefix: StringName = _columns_local_prefix_refusal(columns)
+	if prefix != REFUSE_NONE:
+		return prefix
+	var slot: int = columns.present.find(1, 0)
+	while slot >= 0:
+		if not _species_id_in_range(columns.species[slot]):
+			return REFUSE_COLUMN_SPECIES
+		if not _arrival_tick_is_valid(columns.arrival_tick[slot]):
+			return REFUSE_COLUMN_ARRIVAL_TICK
+		slot = columns.present.find(1, slot + 1)
+	return REFUSE_NONE
+
+
+static func _columns_local_prefix_refusal(columns: Columns) -> StringName:
+	"""Shape, byte domains, skills, reference and equipment shape, free rows, present cap.
+
+	Extracted UNCHANGED from `_restore_column_refusal()`'s sequence between the catalog error
+	and the per-live-row walk, in its original order, so the live path keeps every published
+	diagnostic. Null handling lives in the shared shape helper, which is what makes
+	`copy_columns_into(null)` and `restore_columns(null)` refuse safely.
+	"""
+	if not _columns_are_capacity_sized(columns):
+		return REFUSE_COLUMN_SHAPE
+	var bytes: StringName = _column_byte_domain_refusal(columns)
+	if bytes != REFUSE_NONE:
+		return bytes
+	var skills: StringName = _column_skill_refusal(columns)
+	if skills != REFUSE_NONE:
+		return skills
+	var references: StringName = _column_reference_refusal(columns)
+	if references != REFUSE_NONE:
+		return references
+	var free_rows: StringName = _column_free_row_refusal(columns)
+	if free_rows != REFUSE_NONE:
+		return free_rows
+	if columns.present.count(1) > RESIDENT_LIVING_CAP:
+		return REFUSE_COLUMN_LIVING_CAP
+	return REFUSE_NONE
+
+
+static func _species_id_in_range(species_id_value: int) -> bool:
+	"""True for a compiled species id inside the release-1 catalog's 0..15 domain.
+
+	RANGE ONLY. Whether a present row's size class agrees with that species is the compiled
+	catalog's question and stays in the live restore, which is the only path that holds one.
+	"""
+	return species_id_value >= 0 and species_id_value < SPECIES_COUNT
+
+
+static func _arrival_tick_is_valid(tick: int) -> bool:
+	"""ADR0178's ONE arrival policy: a present row's tick is 0..INT64_MAX, never negative.
+
+	Shared by `set_arrival_tick()`, the pure predicate and the live restore, so the producer and
+	both consumers cannot drift apart. Retained INACTIVE rows are deliberately outside it: a
+	departed row keeps its full signed history and nothing normalizes it.
+	"""
+	return tick >= 0
+
