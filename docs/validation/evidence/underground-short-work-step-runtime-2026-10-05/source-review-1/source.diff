+func test_short_saved_progress_rejects_fraction_and_source_clock_disagreement() -> void:
+	"""Bounded direct saved-state leaves reject malformed rationals and impossible counted prefixes before outputs."""
+	var word: int = Routes.ShortStep.word(Routes.PHASE_TRAVELLING, Routes.SourceProgram.WALK)
+	assert_equal(Routes.ShortStep.progress_refusal(word, 65536, 109, Routes._encode_fraction(7, 30), true), &"", "actual first tick from zero")
+	assert_equal(Routes.ShortStep.progress_refusal(word, 65536, 110, Routes._encode_fraction(1, 5), true), &"", "actual first tick from29/30")
+	for fraction: int in [int(2) << 32 | 4, int(1) << 32, int(1) << 32 | 2147483648, -1]:
+		assert_equal(Routes.ShortStep.progress_refusal(word, 65536, 109, fraction, true), &"ROUTE_SOURCE_STEP_PROGRESS", "malformed saved fraction")
+	assert_equal(Routes.ShortStep.progress_refusal(word, 65536, 108, 0, true), &"ROUTE_SOURCE_STEP_PROGRESS", "clock cannot precede earned root distance")
+	assert_equal(Routes.ShortStep.progress_refusal(word, 65536, 111, 0, true), &"ROUTE_SOURCE_STEP_PROGRESS", "clock cannot borrow extra distance")
+	assert_equal(Routes.ShortStep.progress_refusal(word, 65536, 109, Routes._encode_fraction(7, 30), false), &"ROUTE_SOURCE_STEP_PROGRESS", "positive prefix retains its actual occupied edge")
+	assert_equal(Routes.ShortStep.progress_refusal(word, 0, 0, 0, true), &"ROUTE_SOURCE_STEP_PROGRESS", "zero prefix has not entered an edge")
+
