+static func _iteration_row_refusal(actual: RefCounted, bank: Bank, row: int, revision: int) -> StringName:
+	"""Immutable payload identity and complete section/source facts precede the first caller write."""
+	var capacity: int = actual._capacity
+	if bank.present[row] != 1 or bank.i32[GENERATION * capacity + row] <= 0 \
+			or bank.i64[PAYLOAD_REVISION * capacity + row] <= 0 \
