+		return SaveHeader.Refusal.new(REFUSE_RECORD_SHAPE, "apply was given no record")
+	if commands_store == null or scheduler_store == null:
+		return SaveHeader.Refusal.new(REFUSE_STORE_REFUSED,
+			"apply needs both owner queues; one of them was null")
+	var clock: SimClockScript = commands_store.clock()
+	if clock == null:
+		return SaveHeader.Refusal.new(REFUSE_STORE_REFUSED,
+			"the command queue is bound to no clock")
+	if clock != scheduler_store.clock():
+		return SaveHeader.Refusal.new(REFUSE_STORE_REFUSED,
+			("the two queues are bound to different clock objects; a shared completed tick is "
+				+ "not evidence that they belong to one world"))
