+static func frontier_leaf_refusal(actual: RefCounted, context: Locations.FrontierContext,
+		heap_patch: PackedInt32Array) -> StringName:
+	"""Add exactly two directed spans per new station while preserving all old paths and canonical allocation."""
+	if not _frontier_shapes(actual): return &"ROUTE_FRONTIER_ROWS"
+	if actual == null or context == null or actual != context.graph or actual._locations != context.locations \
+			or actual._owner != context.owner or actual._cold != context.budget or actual._bindings != context.routes \
+			or actual._live != context.graph_live or actual._stage != context.graph_candidate \
