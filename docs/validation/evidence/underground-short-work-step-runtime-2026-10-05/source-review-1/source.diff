+func _short_clock_mutants() -> void:
+	"""Saved-column interpretation rejects reserved tags and a fourth step before publishing caller output."""
+	var row: int = _residents.directory().get_typed_row(_worker)
+	var word: int = _routes._motion.resident[Routes.R_PHASE * Routes.RESIDENT_CAPACITY + row]
+	var clock: int = _routes._motion.resident_long[Routes.R_REQUEST_TICK * Routes.RESIDENT_CAPACITY + row]
+	var out: PackedInt64Array = PackedInt64Array([71, 72, 73, 74])
+	_routes._motion.resident[Routes.R_PHASE * Routes.RESIDENT_CAPACITY + row] = Routes.ShortStep.word(Routes.PHASE_IDLE, Routes.SourceProgram.WALK)
+	_routes._motion.resident_long[Routes.R_REQUEST_TICK * Routes.RESIDENT_CAPACITY + row] = 3 * 65536
+	assert_equal(_routes.source_state_into(_worker, NULL_REF, 10, 1, 3, out), &"ROUTE_SOURCE_TUPLE_STALE", "fourth root tick is outside the full source prefix")
+	assert_equal(out, PackedInt64Array([71, 72, 73, 74]), "refused decode leaves output unchanged")
+	_routes._motion.resident[Routes.R_PHASE * Routes.RESIDENT_CAPACITY + row] = word
+	_routes._motion.resident_long[Routes.R_REQUEST_TICK * Routes.RESIDENT_CAPACITY + row] = clock
+	assert_equal(_routes.source_state_into(_worker, NULL_REF, 10, 1, 3, out), &"", "original saved columns restore exact READY")
+
