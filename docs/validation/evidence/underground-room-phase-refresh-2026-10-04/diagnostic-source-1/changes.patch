+		return &"" if owner._o_kind[found] == Directory.KIND_WORLD and owner._o_a[found] == 0 and owner._o_d[found] == 0 \
+			and owner._o_parent_slot[found] == -1 and owner._o_parent_generation[found] == 0 else &"LOCATION_SOURCE_STALE"
+	var room: int = Owner.CoreSources._final_row(actual._ids, ref, Directory.KIND_ROOM)
+	var buildings: Buildings = actual._buildings
+	if room < 0 or buildings._r_present[room] != 1 or buildings._r_ref_slot[room] != ref.x \
+			or buildings._r_ref_generation[room] != ref.y or buildings._r_spatial_kind[room] != Buildings.ROOM_SPACE_UNDERGROUND \
+			or buildings._r_type[room] < 0 or buildings._r_type[room] >= Buildings.ROOM_TYPE_COUNT:
+		return &"LOCATION_ROOM_STALE"
+	return &"" if owner._o_kind[found] == Directory.KIND_ROOM and owner._o_d[found] == Buildings.ROOM_SPACE_UNDERGROUND \
+		and owner._o_a[found] == buildings._r_type[room] and owner._o_parent_slot[found] == buildings._r_building_slot[room] \
+		and owner._o_parent_generation[found] == buildings._r_building_generation[room] else &"LOCATION_SOURCE_STALE"
+
