+class SourceClosureTests(unittest.TestCase):
+    def test_every_q16_prefix_sample_matches_the_emitted_continuous_interval_table(self):
+        def weights(a, b, share):
+            result = {}
+            for key, weight in ((a, R.ONE - share), (b, share)):
+                if weight:
+                    result[key] = result.get(key, 0) + weight
+            return result
+        for direction in (1, -1):
+            rows, cursor = M.intervals(direction), 0
+            for q in range(3 * R.ONE + 1):
+                while q > rows[cursor]["to_q16"]:
+                    cursor += 1
+                row = rows[cursor]
+                share = (q - row["from_q16"]) * (row["source_share_to_q16"] - row["source_share_from_q16"]) // (row["to_q16"] - row["from_q16"])
+                self.assertEqual(weights(*R.source_interval(q, direction)), weights(row["a"], row["b"], share))
+
+    def test_source_inputs_are_bounded_before_read_and_require_exact_bytes(self):
+        import hashlib
+        with tempfile.TemporaryDirectory(prefix=".step-input-", dir=M.HERE) as directory:
+            path = Path(directory) / "input"
+            path.write_bytes(b"source")
+            digest = hashlib.sha256(b"source").hexdigest()
+            self.assertEqual(M.exact_bytes(path, digest, 6), b"source")
+            for wanted, limit in ((digest, 5), ("0" * 64, 6)):
+                with self.assertRaises(ValueError):
+                    M.exact_bytes(path, wanted, limit)
+            link = Path(directory) / "link"
+            link.symlink_to(path)
+            with self.assertRaises(ValueError):
+                M.exact_bytes(link, digest, 6)
+
+    def test_interval_partition_exhausts_exact_prefix_and_keeps_reverse_seam(self):
+        for direction, count in ((1, 3), (-1, 4)):
+            rows = M.intervals(direction)
+            self.assertEqual(len(rows), count)
+            cursor = 0
+            for row in rows:
+                self.assertEqual(row["from_q16"], cursor)
+                self.assertGreater(row["to_q16"], cursor)
+                cursor = row["to_q16"]
+            self.assertEqual(cursor, 3 * R.ONE)
+        self.assertEqual(M.intervals(-1)[0]["to_q16"], 1)
+        self.assertEqual(M.intervals(-1)[-1]["source_share_to_q16"], 65535)
+
+    def test_every_prefix_ready_simplex_requires_the_full_accepted_predecessor(self):
+        def case(count, duration):
+            return {"frames": count, "source_loop_mode": 1,
+                    "source_duration_s": Fraction(duration, 30 * R.ONE), "duration_q16": duration}
+        cases = [case(122, 121 * R.ONE), case(34, R.WALK_DURATION)]
+        checked = M.C.H.handoff_sets(cases)
+        proof = {"carry_handoffs": {"checked": checked}}
+        self.assertEqual(len(M.handoff_subset(cases, proof, 1)), 4)
+        self.assertEqual(len(M.handoff_subset(cases, proof, -1)), 5)
+        for row in checked:
+            if row["from"] != "idle":
+                bad = copy.deepcopy(proof)
+                bad["carry_handoffs"]["checked"].remove(row)
+                with self.assertRaises(ValueError):
+                    M.handoff_subset(cases, bad, -1)
+
