+static func _iteration_scope_refusal(actual: RefCounted, revision: int) -> StringName:
+	"""Precharge the complete finite source scan and require actual live banks and immutable namespace."""
+	if actual._capacity <= 0 or actual._capacity > MAX_LOCATIONS or actual._owner == null \
+			or actual._sources == null or actual._ids == null or actual._buildings == null or actual._transforms == null \
